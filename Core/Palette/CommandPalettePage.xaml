<Page x:Class="JNNTool.Core.Palette.CommandPalettePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="JNN Command Palette"
      FontFamily="Segoe UI" FontSize="12"
      MinWidth="220"
      SnapsToDevicePixels="True" UseLayoutRounding="True">

    <Page.Resources>
        <ResourceDictionary>
            <!-- COLOR TOKENS -->
            <SolidColorBrush x:Key="BrushBgCanvas" Color="#F5F7F9" />
            <SolidColorBrush x:Key="BrushBgSurface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BrushBgHover" Color="#F0F9FF" />
            <SolidColorBrush x:Key="BrushBorderInput" Color="#DCDDE1" />
            <SolidColorBrush x:Key="BrushBorderSubtle" Color="#E2E8F0" />
            <SolidColorBrush x:Key="BrushBorderFocus" Color="#0284C7" />
            <SolidColorBrush x:Key="BrushTextMain" Color="#2C3E50" />
            <SolidColorBrush x:Key="BrushTextMuted" Color="#64748B" />
            <SolidColorBrush x:Key="BrushTextSubtle" Color="#94A3B8" />
            <SolidColorBrush x:Key="BrushPrimary" Color="#0284C7" />
            <SolidColorBrush x:Key="BrushPrimaryHover" Color="#0369A1" />
            <SolidColorBrush x:Key="BrushPrimaryLight" Color="#E0F2FE" />
            <SolidColorBrush x:Key="BrushStar" Color="#F59E0B" />
            <SolidColorBrush x:Key="BrushSuccess" Color="#10B981" />
            <SolidColorBrush x:Key="BrushDanger" Color="#EF4444" />

            <DropShadowEffect x:Key="TileShadow" BlurRadius="4" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.04" />
            <DropShadowEffect x:Key="TileShadowHover" BlurRadius="8" ShadowDepth="2" Direction="270" Color="#0284C7" Opacity="0.18" />

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Ô tìm kiếm Style -->
            <Style x:Key="SearchBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource BrushTextMain}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Nút xóa tìm kiếm Style -->
            <Style x:Key="ClearButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource BrushTextSubtle}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushPrimaryLight}" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Nút toggle lọc lệnh yêu thích -->
            <Style x:Key="FavToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="ToolTip" Value="Chỉ hiện các lệnh đã ghim yêu thích (★)" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" Background="{StaticResource BrushBgSurface}" CornerRadius="5"
                                    BorderBrush="{StaticResource BrushBorderInput}" BorderThickness="1">
                                <Path x:Name="star" Width="14" Height="14" Stretch="Uniform"
                                      Data="M12,2 L15.09,8.26 L22,9.27 L17,14.14 L18.18,21.02 L12,17.77 L5.82,21.02 L7,14.14 L2,9.27 L8.91,8.26 Z"
                                      Fill="Transparent" Stroke="{StaticResource BrushTextSubtle}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushStar}" />
                                    <Setter TargetName="star" Property="Stroke" Value="{StaticResource BrushStar}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFFBEB" />
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushStar}" />
                                    <Setter TargetName="star" Property="Fill" Value="{StaticResource BrushStar}" />
                                    <Setter TargetName="star" Property="Stroke" Value="{StaticResource BrushStar}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ngôi sao nhỏ ghim trên mỗi card lệnh -->
            <Style x:Key="TileStarStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="5">
                                <Path x:Name="star" Width="11" Height="11" Stretch="Uniform"
                                      Data="M12,2 L15.09,8.26 L22,9.27 L17,14.14 L18.18,21.02 L12,17.77 L5.82,21.02 L7,14.14 L2,9.27 L8.91,8.26 Z"
                                      Fill="Transparent" Stroke="{StaticResource BrushTextSubtle}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FEF3C7" />
                                    <Setter TargetName="star" Property="Stroke" Value="{StaticResource BrushStar}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="star" Property="Fill" Value="{StaticResource BrushStar}" />
                                    <Setter TargetName="star" Property="Stroke" Value="{StaticResource BrushStar}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Nút card lệnh (Tile) -->
            <Style x:Key="TileButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="100" />
                <Setter Property="Height" Value="86" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="{StaticResource BrushBgSurface}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
                <Setter Property="Foreground" Value="{StaticResource BrushTextMain}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
                <Setter Property="ToolTipService.ShowDuration" Value="15000" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="5" Effect="{StaticResource TileShadow}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushBgHover}" />
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                                    <Setter TargetName="bd" Property="Effect" Value="{StaticResource TileShadowHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushPrimaryLight}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Template cho từng ô lệnh -->
            <DataTemplate x:Key="TileTemplate">
                <Button Style="{StaticResource TileButtonStyle}" Click="Tile_Click">
                    <Button.ToolTip>
                        <ToolTip MaxWidth="320" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Normal" FontSize="12"
                                           Foreground="{StaticResource BrushTextMain}" />
                                <TextBlock Text="{Binding Group}" FontSize="11" Margin="0,2,0,4"
                                           Foreground="{StaticResource BrushPrimary}" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}" LineHeight="15" />
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <Grid x:Name="tileRoot" Background="Transparent">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,5,5,3">
                            <Grid Width="32" Height="32" HorizontalAlignment="Center">
                                <Image Source="{Binding Icon}" Width="28" Height="28"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                <!-- Badge chữ cái đầu nếu không có file icon -->
                                <Border x:Name="badge" CornerRadius="5" Visibility="Collapsed">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#38BDF8" Offset="0" />
                                            <GradientStop Color="#0284C7" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Normal" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxHeight="32"
                                       FontSize="11" Margin="0,5,0,0" LineHeight="14"
                                       FontWeight="Normal" Foreground="{StaticResource BrushTextMain}" />
                        </StackPanel>
                        <ToggleButton x:Name="star" Style="{StaticResource TileStarStyle}"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                      IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                      Click="Star_Click" Opacity="0"
                                      ToolTip="Ghim / Bỏ ghim lệnh yêu thích" />
                    </Grid>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasIcon}" Value="False">
                        <Setter TargetName="badge" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                        <Setter TargetName="star" Property="Opacity" Value="1" />
                    </DataTrigger>
                    <Trigger SourceName="tileRoot" Property="IsMouseOver" Value="True">
                        <Setter TargetName="star" Property="Opacity" Value="1" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Template cho từng nhóm lệnh -->
            <DataTemplate x:Key="GroupTemplate">
                <StackPanel Margin="0,0,0,10">
                    <Grid Margin="6,4,6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="groupName" Text="{Binding Name}" FontWeight="Normal" FontSize="12"
                                   Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{StaticResource BrushPrimaryLight}" CornerRadius="5"
                                Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="Normal"
                                       Foreground="{StaticResource BrushPrimaryHover}" />
                        </Border>
                        <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource BrushBorderSubtle}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TileTemplate}"
                                  Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsFavorites}" Value="True">
                        <Setter TargetName="groupName" Property="Foreground" Value="#D97706" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{StaticResource BrushBgCanvas}">
        <Grid.RowDefinitions>
            <!-- Row 0: Search & Filters -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Command List -->
            <RowDefinition Height="*" />
            <!-- Row 2: Status Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: Ô TÌM KIẾM & NÚT LỌC FAVORITES -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="0,0,0,1" Padding="8,8,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Ô tìm kiếm -->
                <Border x:Name="SearchBorder" Height="32" CornerRadius="5" Background="{StaticResource BrushBgSurface}"
                        BorderBrush="{StaticResource BrushBorderInput}" BorderThickness="1">
                    <Grid Margin="8,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Kính lúp icon -->
                        <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                              Stroke="{StaticResource BrushTextSubtle}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M10,2 A8,8 0 1 1 9.99,2 Z M16,16 L22,22" />
                        <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"
                                   Text="Tìm kiếm lệnh JNNTool... (Ctrl+F)" Foreground="{StaticResource BrushTextSubtle}"
                                   FontWeight="Normal" FontSize="12" IsHitTestVisible="False" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" Margin="7,0,0,0" Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                 GotKeyboardFocus="SearchBox_FocusChanged" LostKeyboardFocus="SearchBox_FocusChanged" />
                        <Button x:Name="ClearSearchButton" Grid.Column="2" Style="{StaticResource ClearButtonStyle}"
                                Visibility="Collapsed" Click="ClearSearch_Click" ToolTip="Xóa tìm kiếm (Esc)">
                            <Path Width="8" Height="8" Stretch="Uniform" Data="M0,0 L10,10 M10,0 L0,10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Nút lọc yêu thích ★ -->
                <ToggleButton x:Name="FavoritesOnlyToggle" Grid.Column="1" Margin="6,0,0,0"
                              Style="{StaticResource FavToggleStyle}"
                              Checked="FavoritesOnly_Changed" Unchecked="FavoritesOnly_Changed" />
            </Grid>
        </Border>

        <!-- DANH SÁCH LỆNH CHIA THEO NHÓM -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="6,6,6,6" Focusable="False">
            <Grid>
                <ItemsControl x:Name="GroupsList" ItemTemplate="{StaticResource GroupTemplate}" Focusable="False" />

                <!-- Trạng thái trống khi không tìm thấy kết quả -->
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" Margin="12,40,12,0" HorizontalAlignment="Center">
                    <Path Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                          Stroke="{StaticResource BrushTextSubtle}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M10,2 A8,8 0 1 1 9.99,2 Z M16,16 L22,22" />
                    <TextBlock x:Name="EmptyText" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               FontWeight="Normal" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                               Text="Không tìm thấy lệnh phù hợp" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- FOOTER / STATUS -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource BrushSuccess}"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="7,0,6,0" Text="Sẵn sàng (Nhấn Enter để chạy lệnh đầu tiên)"
                           FontSize="11" FontWeight="Normal" Foreground="{StaticResource BrushTextMuted}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock x:Name="TotalCommandsText" Grid.Column="2" FontSize="10.5" FontWeight="Normal"
                           Foreground="{StaticResource BrushTextSubtle}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>
