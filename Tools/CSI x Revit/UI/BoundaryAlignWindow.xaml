<Window x:Class="JNNTool.Tools.CSIxRevit.UI.BoundaryAlignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JNNTool — Boundary Align" 
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        Foreground="#1E293B">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" Margin="0,0,0,10"/>
                                    <ContentPresenter Grid.Row="1"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1E3A8A"/>
        </Style>

        <!-- Nút hướng trên la bàn: tròn, bấm thì tô xanh (giống ViewCube của Revit) -->
        <Style x:Key="CompassButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="AlignDir"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="19" Background="White"
                                BorderBrush="#94A3B8" BorderThickness="1.5">
                            <TextBlock x:Name="Lbl" Text="{TemplateBinding Content}" Foreground="#475569"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="Bg" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <StackPanel>
                <!-- Group 1: Quét chọn đối tượng -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="1. Quét chọn cấu kiện biên" Style="{StaticResource GroupTitle}"/>
                    </GroupBox.Header>
                    <StackPanel>
                        <Button x:Name="BtnPickObjects" Click="BtnPickObjects_Click"
                                Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                                Height="36" Cursor="Hand" Margin="0,0,0,8">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,0">
                                        <TextBlock Text="Quét chọn trên Revit" FontSize="13" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10,8" BorderBrush="#CBD5E1" BorderThickness="1">
                            <TextBlock x:Name="TxtSelectionStatus" 
                                       Text="Chưa chọn đối tượng nào. Bấm 'Quét chọn trên Revit' để kéo chuột chọn dầm, cột biên trên mặt bằng hoặc 3D." 
                                       FontSize="12" Foreground="#475569" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Group 2: Hướng dời (la bàn kiểu ViewCube) -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="2. Hướng căn lề vào trong lòng nhà" Style="{StaticResource GroupTitle}"/>
                    </GroupBox.Header>
                    <StackPanel HorizontalAlignment="Center">
                        <Grid Width="190" Height="190">
                            <!-- Vòng la bàn -->
                            <Ellipse Width="150" Height="150" Stroke="#E2E8F0" StrokeThickness="18" Fill="Transparent"/>
                            <Ellipse Width="168" Height="168" Stroke="#CBD5E1" StrokeThickness="1"/>
                            <Ellipse Width="132" Height="132" Stroke="#CBD5E1" StrokeThickness="1"/>

                            <!-- Ô TOP ở giữa -->
                            <Border Width="64" Height="64" CornerRadius="4" Background="#F8FAFC"
                                    BorderBrush="#94A3B8" BorderThickness="1.5">
                                <TextBlock Text="TOP" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <RadioButton x:Name="RbShiftUpY" Content="B" Style="{StaticResource CompassButton}"
                                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"
                                         ToolTip="Dời lên phía Bắc (+Y)" Checked="Direction_Checked"/>
                            <RadioButton x:Name="RbShiftDownY" Content="N" Style="{StaticResource CompassButton}"
                                         HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                         ToolTip="Dời xuống phía Nam (-Y)" Checked="Direction_Checked"/>
                            <RadioButton x:Name="RbShiftRightX" Content="Đ" Style="{StaticResource CompassButton}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                                         ToolTip="Dời sang phải, phía Đông (+X)" Checked="Direction_Checked"/>
                            <RadioButton x:Name="RbShiftLeftX" Content="T" Style="{StaticResource CompassButton}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                                         ToolTip="Dời sang trái, phía Tây (-X)" Checked="Direction_Checked"/>
                        </Grid>

                        <TextBlock x:Name="TxtDirection" Text="Bấm B / N / Đ / T để chọn hướng dời"
                                   FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="Hướng theo trục dự án: Bắc = +Y, Đông = +X (như mặt bằng chưa xoay)"
                                   FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Group 3: Khoảng cách dời -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="3. Khoảng cách căn lề" Style="{StaticResource GroupTitle}"/>
                    </GroupBox.Header>
                    <StackPanel>
                        <RadioButton x:Name="RbOffsetHalfWidth" GroupName="Offset" IsChecked="True">
                            <TextBlock Text="Tự động theo B/2, H/2 (100 mm cho dầm 200, 125 mm cho cột 250, 150 mm cho dầm 300)" TextWrapping="Wrap"/>
                        </RadioButton>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <RadioButton x:Name="RbOffsetCustom" GroupName="Offset" Content="Nhập khoảng cách tùy chỉnh:" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCustomOffsetMm" Text="100" Width="70" Height="26" Margin="10,0,0,0"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     BorderBrush="#CBD5E1" Background="#FFFFFF" FontSize="13"/>
                            <TextBlock Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Group 4: Nâng cao -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="4. Xử lý nút giao liên kết" Style="{StaticResource GroupTitle}"/>
                    </GroupBox.Header>
                    <StackPanel>
                        <CheckBox x:Name="ChkAutoExtendIntersecting" 
                                  Content="Tự động co/kéo các dầm ngang vuông góc kết nối vào (Chống hở nút)" 
                                  IsChecked="True" FontWeight="SemiBold"/>
                        <TextBlock Text="Khuyến nghị: Bật tùy chọn này để đầu dầm ngang tự động bắt khít vào mép dầm biên mới."
                                   FontSize="11" Foreground="#64748B" Margin="22,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtAlignResultLog" Grid.Column="0" 
                           Text="Sẵn sàng thực hiện căn lề biên." 
                           FontSize="12" Foreground="#475569" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <Button x:Name="BtnExecuteEdgeAlign" Grid.Column="1" Click="BtnExecuteEdgeAlign_Click"
                        Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="13"
                        Height="38" MinWidth="170" Cursor="Hand" Margin="12,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="16,0">
                                <TextBlock Text="Thực Hiện Căn Lề Biên" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Content="Đóng" Click="BtnClose_Click"
                        Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" FontSize="13"
                        Height="38" Width="75" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <TextBlock Text="Đóng" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
