<Window x:Class="JNNTool.Tools.CSIxRevit.UI.BoundaryAlignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JNNTool — Căn Lề Biên Dầm &amp; Cột" 
        Height="620" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        Foreground="#1E293B">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" Margin="0,0,0,10"/>
                                    <ContentPresenter Grid.Row="1"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2563EB" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🎯 CĂN LỀ BIÊN DẦM &amp; CỘT" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Dời mép dầm/cột vào trong ranh đất và tự động co kéo dầm nối" FontSize="12" Foreground="#DBEAFE" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="JNNTool" FontSize="14" FontWeight="Bold" Foreground="#93C5FD" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <StackPanel>
                <!-- Group 1: Quét chọn đối tượng -->
                <GroupBox>
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="1. 📐 Quét chọn cấu kiện biên" FontWeight="Bold" FontSize="14" Foreground="#1E3A8A"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnPickObjects" Click="BtnPickObjects_Click"
                                    Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                                    Height="36" Cursor="Hand" Margin="0,0,4,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,0">
                                            <TextBlock Text="🎯 Quét chọn trên Revit" FontSize="13" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BtnUseCurrentSelection" Grid.Column="1" Click="BtnUseCurrentSelection_Click"
                                    Background="#3B82F6" Foreground="White" FontWeight="SemiBold"
                                    Height="36" Cursor="Hand" Margin="4,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,0">
                                            <TextBlock Text="🔄 Lấy đối tượng đang chọn" FontSize="13" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10,8" BorderBrush="#CBD5E1" BorderThickness="1">
                            <TextBlock x:Name="TxtSelectionStatus" 
                                       Text="Chưa chọn đối tượng nào. Bấm nút 'Quét chọn' để kéo chuột chọn dầm, cột trên mặt bằng hoặc 3D." 
                                       FontSize="12" Foreground="#475569" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Group 2: Hướng dời -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="2. 🧭 Hướng căn lề vào trong lòng nhà" FontWeight="Bold" FontSize="14" Foreground="#1E3A8A"/>
                    </GroupBox.Header>
                    <StackPanel>
                        <RadioButton x:Name="RbAutoGrid" Content="🎯 Tự động tìm hướng vào trong (Theo tâm công trình / Lưới trục)" IsChecked="True" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                        <Separator Margin="0,6,0,6" Background="#E2E8F0"/>
                        <TextBlock Text="Hoặc chọn hướng cố định thủ công:" FontSize="12" Foreground="#64748B" Margin="0,2,0,4"/>
                        <Grid Margin="12,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <RadioButton x:Name="RbShiftDownY" Content="⬇️ Dời xuống (-Y - Nam)"/>
                                <RadioButton x:Name="RbShiftUpY" Content="⬆️ Dời lên (+Y - Bắc)"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <RadioButton x:Name="RbShiftLeftX" Content="⬅️ Dời sang trái (-X - Tây)"/>
                                <RadioButton x:Name="RbShiftRightX" Content="➡️ Dời sang phải (+X - Đông)"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Group 3: Khoảng cách dời -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="3. 📏 Khoảng cách căn lề" FontWeight="Bold" FontSize="14" Foreground="#1E3A8A"/>
                    </GroupBox.Header>
                    <StackPanel>
                        <RadioButton x:Name="RbOffsetHalfWidth" Content="📐 Tự động theo B/2 (100 mm cho dầm 200, 150 mm cho dầm 300)" IsChecked="True"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <RadioButton x:Name="RbOffsetCustom" Content="✏️ Nhập khoảng cách tùy chỉnh:" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCustomOffsetMm" Text="100" Width="70" Height="26" Margin="10,0,0,0"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     BorderBrush="#CBD5E1" Background="#FFFFFF" FontSize="13"/>
                            <TextBlock Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Group 4: Nâng cao -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="4. ⚙️ Xử lý nút giao liên kết" FontWeight="Bold" FontSize="14" Foreground="#1E3A8A"/>
                    </GroupBox.Header>
                    <StackPanel>
                        <CheckBox x:Name="ChkAutoExtendIntersecting" 
                                  Content="🔗 Tự động co/kéo các dầm ngang vuông góc kết nối vào (Chống hở nút)" 
                                  IsChecked="True" FontWeight="SemiBold"/>
                        <TextBlock Text="Khuyến nghị: Bật tùy chọn này để đầu dầm ngang tự động bắt khít vào mép dầm biên mới."
                                   FontSize="11" Foreground="#64748B" Margin="22,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtAlignResultLog" Grid.Column="0" 
                           Text="Sẵn sàng thực hiện căn lề biên." 
                           FontSize="12" Foreground="#475569" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <Button x:Name="BtnExecuteEdgeAlign" Grid.Column="1" Click="BtnExecuteEdgeAlign_Click"
                        Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="13"
                        Height="38" MinWidth="180" Cursor="Hand" Margin="12,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="16,0">
                                <TextBlock Text="🚀 Thực Hiện Căn Lề Biên" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Content="Đóng" Click="BtnClose_Click"
                        Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" FontSize="13"
                        Height="38" Width="75" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <TextBlock Text="Đóng" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
