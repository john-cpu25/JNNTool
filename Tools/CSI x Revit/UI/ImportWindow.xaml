<Window x:Class="JNNTool.Tools.CSIxRevit.UI.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSI ETABS ➔ Autodesk Revit" Height="740" Width="1240" MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC" FontFamily="Segoe UI" FontWeight="Normal">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0EA5E9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0EA5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- Small uppercase caption above an input -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TemplateCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="DisplayMemberPath" Value="Name"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <!-- Buttons: flat, rounded, hover / pressed / disabled states -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0369A1"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#075985"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#059669"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#047857"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#E2E8F0"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentOutlineButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#7DD3FC"/>
            <Setter Property="Background" Value="#F0F9FF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0F2FE"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CBD5E1"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TabControl -->
        <TabControl x:Name="MainTabControl" Grid.Row="0" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: CREATE MISSING SECTIONS -->
            <TabItem x:Name="TabCreateSections" Header="1.  Create Missing Sections">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: default templates per element type -->
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Default Templates" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <TextBlock Text="  ·  Type used as the base to duplicate new sections, per element type"
                                           FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </StackPanel>

                            <UniformGrid Grid.Row="1" Grid.Column="0" Columns="5" VerticalAlignment="Bottom">
                                <StackPanel Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Ellipse Width="8" Height="8" Fill="#6366F1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="BEAM" Style="{StaticResource FieldLabel}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbDefaultBeamTemplate" Style="{StaticResource TemplateCombo}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Ellipse Width="8" Height="8" Fill="#F43F5E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="COLUMN" Style="{StaticResource FieldLabel}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbDefaultColTemplate" Style="{StaticResource TemplateCombo}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Ellipse Width="8" Height="8" Fill="#0EA5E9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="SLAB (S)" Style="{StaticResource FieldLabel}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbDefaultSlabTemplate" Style="{StaticResource TemplateCombo}"
                                              ToolTip="Regular Floor type used to duplicate S slabs"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="FOUNDATION SLAB (F)" Style="{StaticResource FieldLabel}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbDefaultFoundationTemplate" Style="{StaticResource TemplateCombo}"
                                              ToolTip="Structural Foundation: Slab type used to duplicate F slabs"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Ellipse Width="8" Height="8" Fill="#14B8A6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="WALL" Style="{StaticResource FieldLabel}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbDefaultWallTemplate" Style="{StaticResource TemplateCombo}"/>
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="4,0,0,0">
                                <Button x:Name="BtnApplyGlobalTemplate" Content="Apply Templates" Height="30"
                                        Style="{StaticResource PrimaryButton}" Click="BtnApplyGlobalTemplate_Click" Margin="0,0,8,0"
                                        ToolTip="Apply the default templates above to every row that is still missing"/>
                                <Button x:Name="BtnSelectAllMissing" Content="Select All Missing" Height="30"
                                        Style="{StaticResource AccentOutlineButton}" Click="BtnSelectAllMissing_Click"
                                        ToolTip="Tick / untick every row that is still missing in Revit"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Sections to create -->
                    <DataGrid x:Name="DgCreateSections" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" Background="White" RowHeight="34" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"
                              FontWeight="Normal" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Create" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridTextColumn Header="ETABS Section" Binding="{Binding SectionName}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Element Type" Binding="{Binding ElementType}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Size (B×H / Thk)" Binding="{Binding DimensionSummary}" Width="120" IsReadOnly="True" Foreground="#0284C7"/>
                            <DataGridTemplateColumn Header="Family" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableFamilies}"
                                                  SelectedItem="{Binding SelectedFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanEdit}"
                                                  Margin="2" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Base Type (duplicate from)" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableTemplates}"
                                                  SelectedItem="{Binding SelectedTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Name"
                                                  IsEnabled="{Binding CanEdit}"
                                                  Margin="2" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Revit Type (new name)" Width="*" MinWidth="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TargetTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding CanEdit}"
                                                 Margin="2" Padding="4,2" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                 BorderBrush="#CBD5E1" Foreground="#0F172A"
                                                 ToolTip="Defaults to the ETABS section name. You can edit it before creating."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="210" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding StatusText}">
                                            <Border x:Name="Badge" Width="16" Height="16" CornerRadius="8" Background="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="BadgeGlyph" Text="•" Foreground="White" FontSize="10" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding StatusLevel}" Value="Ok">
                                                <Setter TargetName="Badge" Property="Background" Value="#16A34A"/>
                                                <Setter TargetName="BadgeGlyph" Property="Text" Value="✓"/>
                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="#15803D"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusLevel}" Value="Missing">
                                                <Setter TargetName="Badge" Property="Background" Value="#F59E0B"/>
                                                <Setter TargetName="BadgeGlyph" Property="Text" Value="!"/>
                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="#B45309"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusLevel}" Value="Skip">
                                                <Setter TargetName="Badge" Property="Background" Value="#94A3B8"/>
                                                <Setter TargetName="BadgeGlyph" Property="Text" Value="–"/>
                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="#64748B"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusLevel}" Value="Error">
                                                <Setter TargetName="Badge" Property="Background" Value="#DC2626"/>
                                                <Setter TargetName="BadgeGlyph" Property="Text" Value="✕"/>
                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="#B91C1C"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bottom Bar of Tab 1 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="BtnCancelCreate" Content="Cancel" MinWidth="90" Margin="0,0,10,0"
                                Style="{StaticResource GhostButton}" Click="BtnCancel_Click"/>
                        <Button x:Name="BtnCreateSelected" Content="Create Selected Sections in Revit"
                                Style="{StaticResource PrimaryButton}" Click="BtnCreateSelected_Click" Margin="0,0,10,0"/>
                        <Button x:Name="BtnGoToMapping" Content="Go to Section Mapping  ➔"
                                Style="{StaticResource GhostButton}" Click="BtnGoToMapping_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: SECTION MAPPING -->
            <TabItem x:Name="TabMapping" Header="2.  Section Mapping">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Level & Options -->
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="BASE LEVEL IN REVIT" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbLevels" Width="200" Style="{StaticResource TemplateCombo}"/>
                            </StackPanel>

                            <CheckBox x:Name="ChkApplyCardinalPoint" Content="Apply ETABS Cardinal Point" IsChecked="True"
                                      VerticalAlignment="Bottom" Foreground="#334155" Margin="0,0,24,7"
                                      ToolTip="Align the beam top face with the story elevation (CARDINALPT 8)"/>

                            <CheckBox x:Name="ChkFitScopeBox" Content="Place Scope Box 'JNN_SB' at building center" IsChecked="True"
                                      VerticalAlignment="Bottom" Foreground="#334155" Margin="0,0,0,7"
                                      ToolTip="After building, places Scope Box named 'JNN_SB' at the exact building center (X, Y, Z) so you can easily locate and adjust it around the house. Then click 'Fit Scope Box' on the ribbon to lock Grids and Levels."/>
                        </WrapPanel>
                    </Border>

                    <!-- Section mapping grid -->
                    <DataGrid x:Name="DgMapping" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                              HeadersVisibility="Column" Background="White" RowHeight="34" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"
                              FontWeight="Normal" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ETABS Section" Binding="{Binding EtabsSectionName}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Section Info (Size - Material)" Binding="{Binding SectionDetails}" Width="230" IsReadOnly="True" Foreground="#475569"/>
                            <DataGridTextColumn Header="Element Type" Binding="{Binding ElementType}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Count" Binding="{Binding ObjectCount}" Width="70" IsReadOnly="True" Foreground="#475569"/>
                            <DataGridTemplateColumn Header="Revit Family / Type" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableTypes}"
                                                  SelectedItem="{Binding SelectedType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Name"
                                                  Margin="2" VerticalAlignment="Center"
                                                  FontWeight="Normal"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bottom Bar of Tab 2 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="BtnAutoMatch" Content="Auto Match" MinWidth="120" Margin="0,0,10,0"
                                Style="{StaticResource AccentOutlineButton}" Click="BtnAutoMatch_Click"
                                ToolTip="Auto-assign a Revit type to every ETABS section by name and size"/>
                        <Button x:Name="BtnReload" Content="Refresh" MinWidth="100" Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButton}" Click="BtnReload_Click"
                                ToolTip="Re-read families / types from the Revit document"/>
                        <Button x:Name="BtnCancel" Content="Cancel" MinWidth="90" Margin="0,0,10,0"
                                Style="{StaticResource GhostButton}" Click="BtnCancel_Click"/>
                        <Button x:Name="BtnImport" Content="Build Model" MinWidth="150"
                                Style="{StaticResource SuccessButton}" Click="BtnImport_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
