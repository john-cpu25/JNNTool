<Window x:Class="JNNTool.Tools.CSIxRevit.UI.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSI ETABS ➔ Autodesk Revit" Height="700" Width="920"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC" FontFamily="Segoe UI" FontWeight="Normal">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0EA5E9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0EA5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" Padding="16,12" CornerRadius="8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="CSI ETABS ➔ AUTODESK REVIT (E2K IMPORTER)" Foreground="White" FontSize="14" FontWeight="Normal"/>
                <TextBlock Text="Tạo tiết diện thiếu, khớp Family/Type và dựng hình kết cấu chính xác." Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- TabControl -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: TẠO TIẾT DIỆN THIẾU -->
            <TabItem x:Name="TabCreateSections" Header="1. 🛠️ Tạo tiết diện thiếu">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Global template selectors -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Template Dầm:" VerticalAlignment="Center" Foreground="#334155" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbDefaultBeamTemplate" Width="170" DisplayMemberPath="Name" VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <TextBlock Text="Template Cột:" VerticalAlignment="Center" Foreground="#334155" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbDefaultColTemplate" Width="170" DisplayMemberPath="Name" VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <Button x:Name="BtnApplyGlobalTemplate" Content="Áp dụng Template" Height="28" Padding="10,0"
                                    Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="BtnApplyGlobalTemplate_Click" Margin="0,0,10,0"/>

                            <Button x:Name="BtnSelectAllMissing" Content="Chọn tất cả chưa có" Height="28" Padding="8,0"
                                    Background="#F1F5F9" Foreground="#0284C7" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="BtnSelectAllMissing_Click"/>
                        </WrapPanel>
                    </Border>

                    <!-- DataGrid danh sách tiết diện cần tạo -->
                    <DataGrid x:Name="DgCreateSections" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" Background="White" RowHeight="34" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"
                              FontWeight="Normal" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Tạo" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <DataGridTextColumn Header="Tiết diện ETABS" Binding="{Binding SectionName}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Loại Đối Tượng" Binding="{Binding ElementType}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Kích thước (B×H / Dày)" Binding="{Binding DimensionSummary}" Width="150" IsReadOnly="True" Foreground="#0284C7"/>
                            <DataGridTemplateColumn Header="Family / Type Template mẫu để nhân bản" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableTemplates}"
                                                  SelectedItem="{Binding SelectedTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Name"
                                                  Margin="2" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="150" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bottom Bar of Tab 1 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="BtnCreateSelected" Content="⚡ Tạo các tiết diện đã chọn trong Revit" Height="36" Padding="16,0"
                                Background="#0284C7" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCreateSelected_Click" Margin="0,0,10,0"/>
                        <Button x:Name="BtnGoToMapping" Content="Chuyển sang Tab Khớp tiết diện ➔" Height="36" Padding="14,0"
                                Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Cursor="Hand" Click="BtnGoToMapping_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: KHỚP TIẾT DIỆN (MAPPING) -->
            <TabItem x:Name="TabMapping" Header="2. 📋 Khớp tiết diện (Mapping)">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Level & Options -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Chọn Level gốc trong Revit:" VerticalAlignment="Center" Foreground="#334155" Margin="0,0,10,0"/>
                                <ComboBox x:Name="CmbLevels" Width="180" DisplayMemberPath="Name" VerticalAlignment="Center"/>
                            </StackPanel>

                            <CheckBox x:Name="ChkApplyCardinalPoint" Content="Áp dụng Cardinal Point từ ETABS" IsChecked="True"
                                      VerticalAlignment="Center" Foreground="#334155" Margin="0,0,20,0"
                                      ToolTip="Căn chỉnh mặt trên dầm trùng với cao độ tầng (CARDINALPT 8)"/>

                            <CheckBox x:Name="ChkApplyEdgeAlignment" Content="Căn chỉnh dầm/cột biên vào trong" IsChecked="False"
                                      VerticalAlignment="Center" Foreground="#334155"
                                      ToolTip="Mặc định TẮT để giữ đúng 100% tọa độ tim cột và dầm theo mô hình E2K (khuyến nghị). Bật: Dời tim cột biên vào trong (đã có cơ chế bảo vệ chống xiên dầm)."/>
                        </WrapPanel>
                    </Border>

                    <!-- DataGrid mapping tiết diện -->
                    <DataGrid x:Name="DgMapping" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                              HeadersVisibility="Column" Background="White" RowHeight="34" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"
                              FontWeight="Normal" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tiết diện ETABS" Binding="{Binding EtabsSectionName}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Thông tin Tiết diện (Size - Mat)" Binding="{Binding SectionDetails}" Width="220" IsReadOnly="True" Foreground="#475569"/>
                            <DataGridTextColumn Header="Loại Đối Tượng" Binding="{Binding ElementType}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Số Lượng" Binding="{Binding ObjectCount}" Width="70" IsReadOnly="True" Foreground="#475569"/>
                            <DataGridTemplateColumn Header="Revit Family / Type (Tiết diện)" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableTypes}"
                                                  SelectedItem="{Binding SelectedType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Name"
                                                  Margin="2" VerticalAlignment="Center"
                                                  FontWeight="Normal"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer / Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnAutoMatch" Content="⚡ Tự động Khớp" Width="130" Height="34" Margin="0,0,10,0"
                    Background="#0EA5E9" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAutoMatch_Click"/>
            <Button x:Name="BtnReload" Content="🔄 Làm mới" Width="100" Height="34" Margin="0,0,10,0"
                    Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="BtnReload_Click"/>
            <Button x:Name="BtnCancel" Content="Hủy bỏ" Width="90" Height="34" Margin="0,0,10,0"
                    Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
            <Button x:Name="BtnImport" Content="🚀 Bắt đầu Dựng Hình" Width="170" Height="34"
                    Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnImport_Click"/>
        </StackPanel>
    </Grid>
</Window>
