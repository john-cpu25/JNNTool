$ FUNCTIONS
  FUNCTION "RampTH"  FUNCTYPE "HISTORY"  HISTTYPE "USER"  
  FUNCTION "RampTH"  TIMEVAL "0  0  1  1  4  1"  
  FUNCTION "DCL"  FUNCTYPE "SPECTRUM"  DAMPRATIO 0.05  SPECTYPE "EUROCODE8-2004"  COUNTRY "CEN Default"  DIRECTION "Horizontal"  AG 0.471 SPECTRUMTYPE "2"  GROUNDTYPE "C"  Q 1.5 

$ GENERALIZED DISPLACEMENTS

