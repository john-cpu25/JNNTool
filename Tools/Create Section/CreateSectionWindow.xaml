<Window x:Class="JNNTool.CreateSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo Section Dầm / Cột" Height="580" Width="500"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ResizeMode="CanResizeWithGrip"
        MinHeight="480" MinWidth="420"
        Background="#FFFFFF">

    <Window.Resources>
        <!-- Styles chung (Light Theme) -->
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#333333"/>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Tiêu đề -->
            <RowDefinition Height="16"/>    <!-- Spacer -->
            <RowDefinition Height="Auto"/>  <!-- Loại: Dầm / Cột -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>  <!-- Family -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>  <!-- Type gốc -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- Nhập kích thước header -->
            <RowDefinition Height="Auto"/>  <!-- TextBox nhập -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>  <!-- Preview header -->
            <RowDefinition Height="*"/>     <!-- DataGrid preview -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- === Tiêu đề === -->
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBlock Text="Tạo Section Dầm / Cột"
                       Foreground="#3B82F6"
                       FontFamily="Segoe UI Semibold"
                       FontSize="18"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Duplicate type hàng loạt theo kích thước b × h"
                       Foreground="#9CA3AF"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
            <Rectangle Height="1" Fill="#E5E7EB" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- === Loại: Dầm / Cột === -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Loại:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
            <ComboBox x:Name="cmbCategory" Style="{StaticResource ComboStyle}"
                      Grid.Column="1" SelectionChanged="CmbCategory_SelectionChanged">
                <ComboBoxItem Content="Dầm (Structural Framing)" IsSelected="True"/>
                <ComboBoxItem Content="Cột (Structural Column)"/>
            </ComboBox>
        </Grid>

        <!-- === Family === -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Family:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
            <ComboBox x:Name="cmbFamily" Style="{StaticResource ComboStyle}"
                      Grid.Column="1" SelectionChanged="CmbFamily_SelectionChanged"/>
        </Grid>

        <!-- === Type gốc === -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Type gốc:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
            <ComboBox x:Name="cmbBaseType" Style="{StaticResource ComboStyle}"
                      Grid.Column="1"/>
        </Grid>

        <!-- === Nhập kích thước === -->
        <Grid Grid.Row="8" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                <Run Text="Nhập kích thước " Foreground="#6B7280" FontSize="12" FontFamily="Segoe UI"/>
                <Run Text="b×h" Foreground="#D97706" FontSize="12" FontFamily="Segoe UI Semibold"/>
                <Run Text=" (mỗi dòng 1 kích thước, VD: 200x400):" Foreground="#6B7280" FontSize="12" FontFamily="Segoe UI"/>
            </TextBlock>
            <Button x:Name="btnParse" Content="⟳  Parse" Grid.Column="1"
                    Style="{StaticResource AccentButton}"
                    Click="BtnParse_Click" Margin="6,0,0,0"/>
        </Grid>

        <TextBox x:Name="txtDimensions" Grid.Row="9"
                 Background="#F9FAFB" Foreground="#333333"
                 BorderBrush="#CCCCCC" BorderThickness="1"
                 FontFamily="Consolas" FontSize="13"
                 Height="80" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 CaretBrush="#333333"
                 Padding="6,4"
                 Text="200x300&#x0a;200x400&#x0a;300x600"/>

        <!-- === Preview header === -->
        <TextBlock Grid.Row="11" Text="Xem trước:" Foreground="#6B7280"
                   FontFamily="Segoe UI" FontSize="12" Margin="0,0,0,4"/>

        <!-- === DataGrid Preview === -->
        <Border Grid.Row="12" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                Background="#F9FAFB">
            <DataGrid x:Name="dgPreview"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      Foreground="#333333"
                      FontFamily="Segoe UI" FontSize="12"
                      BorderThickness="0"
                      RowBackground="#FFFFFF"
                      AlternatingRowBackground="#F3F4F6"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E5E7EB"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F3F4F6"/>
                        <Setter Property="Foreground" Value="#6B7280"/>
                        <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên Type Mới" Binding="{Binding TypeName}" Width="*"/>
                    <DataGridTextColumn Header="b (mm)" Binding="{Binding B}" Width="70"/>
                    <DataGridTextColumn Header="h (mm)" Binding="{Binding H}" Width="70"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- === Buttons === -->
        <Grid Grid.Row="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnCancel" Content="Huỷ" Grid.Column="0"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnCancel_Click"/>
            <Button x:Name="btnCreate" Content="▶  Tạo Section" Grid.Column="2"
                    Style="{StaticResource PrimaryButton}"
                    Click="BtnCreate_Click"/>
        </Grid>
    </Grid>
</Window>
