<Window x:Class="JNNTool.RebarBeamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JNNTool"
        mc:Ignorable="d"
        Title="Rebar Beam Configuration" Height="850" Width="420" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Continuous Beam Rebars" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Top Layer -->
        <GroupBox Header="Top Layer (Lớp trên)" Grid.Row="1" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableRebarTypes}" SelectedItem="{Binding SelectedTopRebarType}" DisplayMemberPath="Name" Margin="0,0,15,0"/>
                
                <TextBlock Grid.Column="2" Text="Qty:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="3" Text="{Binding TopRebarQuantity}" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Top Add Layer -->
        <GroupBox Header="Top Additional (Gia cường gối)" Grid.Row="2" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                
                <CheckBox IsChecked="{Binding EnableTopAdd}" Content="Enable" VerticalAlignment="Center" Margin="0,0,10,0"/>
                
                <TextBlock Grid.Column="1" Text="Type:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableRebarTypes}" SelectedItem="{Binding SelectedTopAddRebarType}" DisplayMemberPath="Name" Margin="0,0,15,0" IsEnabled="{Binding EnableTopAdd}"/>
                
                <TextBlock Grid.Column="3" Text="Qty:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="4" Text="{Binding TopAddQuantity}" VerticalAlignment="Center" IsEnabled="{Binding EnableTopAdd}"/>
            </Grid>
        </GroupBox>

        <!-- Bottom Layer -->
        <GroupBox Header="Bottom Layer (Lớp dưới)" Grid.Row="3" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableRebarTypes}" SelectedItem="{Binding SelectedBottomRebarType}" DisplayMemberPath="Name" Margin="0,0,15,0"/>

                <TextBlock Grid.Column="2" Text="Qty:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="3" Text="{Binding BottomRebarQuantity}" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Bottom Add Layer -->
        <GroupBox Header="Bottom Additional (Gia cường bụng)" Grid.Row="4" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                
                <CheckBox IsChecked="{Binding EnableBottomAdd}" Content="Enable" VerticalAlignment="Center" Margin="0,0,10,0"/>
                
                <TextBlock Grid.Column="1" Text="Type:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableRebarTypes}" SelectedItem="{Binding SelectedBottomAddRebarType}" DisplayMemberPath="Name" Margin="0,0,15,0" IsEnabled="{Binding EnableBottomAdd}"/>
                
                <TextBlock Grid.Column="3" Text="Qty:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="4" Text="{Binding BottomAddQuantity}" VerticalAlignment="Center" IsEnabled="{Binding EnableBottomAdd}"/>
            </Grid>
        </GroupBox>

        <!-- Stirrups -->
        <GroupBox Header="Stirrups (Thép đai)" Grid.Row="5" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableRebarTypes}" SelectedItem="{Binding SelectedStirrupRebarType}" DisplayMemberPath="Name" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Text="Support Spacing (L0/4):" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Text="{Binding StirrupSupportSpacing}" Width="80" VerticalAlignment="Center"/>
                    <TextBlock Text=" mm" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Mid-Span Spacing:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Text="{Binding StirrupMidSpacing}" Width="80" VerticalAlignment="Center"/>
                    <TextBlock Text=" mm" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- General Settings -->
        <GroupBox Header="Settings (Cài đặt móc/neo)" Grid.Row="6" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Top Hook (Móc trên):" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableHookTypes}" SelectedItem="{Binding SelectedTopHookType}" DisplayMemberPath="Name" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Text="Bottom Hook (Móc dưới):" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableHookTypes}" SelectedItem="{Binding SelectedBottomHookType}" DisplayMemberPath="Name" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Text="Stirrup Hook (Móc đai):" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableHookTypes}" SelectedItem="{Binding SelectedStirrupHookType}" DisplayMemberPath="Name" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="3" Text="Top Anchorage (Neo trên):" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Text="{Binding TopAnchorageD}" Width="50" VerticalAlignment="Center"/>
                    <TextBlock Text=" x D" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Text="Bottom Anchorage (Neo dưới):" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Text="{Binding BottomAnchorageD}" Width="50" VerticalAlignment="Center"/>
                    <TextBlock Text=" x D" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="7" Text="Note: Select continuous beams before running the tool." FontStyle="Italic" Foreground="Gray" Margin="0,5,0,0" TextWrapping="Wrap"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="OK" Width="75" Margin="0,0,10,0" Click="BtnOk_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="75" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
