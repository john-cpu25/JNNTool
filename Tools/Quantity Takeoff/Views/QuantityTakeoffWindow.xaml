<Window x:Class="JNNTool.Tools.QuantityTakeoff.Views.QuantityTakeoffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:JNNTool.Tools.QuantityTakeoff.Models"
        Title="JNN — Quantity Takeoff &amp; 3D Section Box"
        Height="720" Width="1240" MinHeight="580" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7F9"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="#2C3E50"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="Accent" Color="#2E5C9A"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1E3E6B"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#16A34A"/>
        <SolidColorBrush x:Key="AccentGreenHover" Color="#15803D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#DCDDE1"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Ink" Color="#2C3E50"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#F1F5F9"/>

        <!-- Modern Flat ProgressBar Template -->
        <ControlTemplate x:Key="FlatProgressBar" TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid x:Name="PART_Track">
                    <Border x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="2"/>
                </Grid>
            </Border>
        </ControlTemplate>

        <!-- Segment Button for By Level Mode -->
        <Style TargetType="Button" x:Key="BtnSegmentLevel">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLevelPreviewMode}" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Segment Button for By Category Mode -->
        <Style TargetType="Button" x:Key="BtnSegmentCategory">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCategoryPreviewMode}" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Toggle Preview Button Style -->
        <Style TargetType="Button" x:Key="BtnTogglePreview">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPreviewVisible}" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="BorderBrush" Value="#93C5FD"/>
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Base Label -->
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Modern TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="5">
                <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,8,0" Fill="#7F8C8D" Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,0,24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="White"
                                            BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Margin="0,2,0,4">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button (CornerRadius 5, Normal Font) -->
        <Style TargetType="Button" x:Key="BtnSecondary">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button (Box 3D) -->
        <Style TargetType="Button" x:Key="BtnPrimary">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green Accent Button (Export Excel) -->
        <Style TargetType="Button" x:Key="BtnGreen">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGreenHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Table Button (Box 3D in grid row) -->
        <Style TargetType="Button" x:Key="BtnRowAction">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl & TabItem Styles (CornerRadius 5, Normal Font) -->
        <Style TargetType="TabItem">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="5,5,0,0"
                                Margin="0,0,4,-1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="White"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{StaticResource HeaderBg}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Controls & Scope -->
            <RowDefinition Height="Auto"/> <!-- Metric Cards -->
            <RowDefinition Height="*"/>    <!-- Tabs Content -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 0: Top Scope & Action Toolbar
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Scope Selection -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Scope:" Style="{StaticResource Label}" Margin="0,0,8,0" Foreground="{StaticResource Muted}"/>
                    <ComboBox Width="145"
                              ItemsSource="{Binding ScopeOptions}"
                              SelectedItem="{Binding SelectedScopeOption, Mode=TwoWay}"/>

                    <!-- Categories Filter Toggle & Popup -->
                    <Grid Margin="10,0,0,0" VerticalAlignment="Center">
                        <ToggleButton x:Name="BtnCategoryFilter" Content="Categories Filter ▼"
                                      IsChecked="{Binding Path=IsOpen, ElementName=PopupCatFilter, Mode=TwoWay}"
                                      Height="28" Padding="12,0" Background="White" Foreground="{StaticResource Ink}"
                                      BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                      FontWeight="Normal" FontSize="12" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PopupCatFilter" StaysOpen="False" Placement="Bottom"
                               PlacementTarget="{Binding ElementName=BtnCategoryFilter}" AllowsTransparency="True"
                               PopupAnimation="Slide">
                            <Border Background="White" BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,4,0,0"
                                    MinWidth="280">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.12" Color="#0F172A"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Structural" Command="{Binding SelectStructuralOnlyCommand}"
                                                Style="{StaticResource BtnSecondary}" Height="24" Padding="8,0" Margin="0,0,4,0" FontSize="11"/>
                                        <Button Content="All" Command="{Binding SelectAllCategoriesCommand}"
                                                Style="{StaticResource BtnSecondary}" Height="24" Padding="8,0" Margin="0,0,4,0" FontSize="11"/>
                                        <Button Content="Clear" Command="{Binding ClearCategoriesCommand}"
                                                Style="{StaticResource BtnSecondary}" Height="24" Padding="8,0" FontSize="11"/>
                                    </StackPanel>
                                    <Separator Margin="0,0,0,8" Background="{StaticResource BorderColor}"/>
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Categories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:CategoryFilterItem}">
                                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="2,4"
                                                              Content="{Binding DisplayName}" FontWeight="Normal" FontSize="12"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⟳ Refresh" Command="{Binding RefreshDataCommand}"
                            Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"/>
                    <Button Content="📊 Visual Preview" Command="{Binding TogglePreviewCommand}"
                            Style="{StaticResource BtnTogglePreview}" Margin="0,0,8,0"/>
                    <Button Content="Select in Model" Command="{Binding SelectInModelCommand}"
                            Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"/>
                    <Button Content="⤢ Box 3D" Command="{Binding Box3DCommand}"
                            Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
                    <Button Content="📊 Export Excel" Command="{Binding ExportExcelCommand}"
                            Style="{StaticResource BtnGreen}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 1: Summary Metric Cards (4 Cards)
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Concrete Volume -->
            <Border Grid.Column="0" Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                    CornerRadius="5" Padding="12,8" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Bê Tông (Concrete Volume)" FontSize="11" Foreground="{StaticResource Muted}" FontWeight="Normal"/>
                    <TextBlock Text="{Binding TotalConcreteVolumeDisplay}" FontSize="16" Foreground="{StaticResource Accent}" FontWeight="Normal" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Formwork Area -->
            <Border Grid.Column="1" Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                    CornerRadius="5" Padding="12,8" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Ván Khuôn (Formwork Area)" FontSize="11" Foreground="{StaticResource Muted}" FontWeight="Normal"/>
                    <TextBlock Text="{Binding TotalFormworkAreaDisplay}" FontSize="16" Foreground="#0284C7" FontWeight="Normal" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Steel / Rebar Weight -->
            <Border Grid.Column="2" Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                    CornerRadius="5" Padding="12,8" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Thép / Rebar (Weight)" FontSize="11" Foreground="{StaticResource Muted}" FontWeight="Normal"/>
                    <TextBlock Text="{Binding TotalSteelWeightDisplay}" FontSize="16" Foreground="#D97706" FontWeight="Normal" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Total Elements -->
            <Border Grid.Column="3" Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                    CornerRadius="5" Padding="12,8" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Tổng Số Cấu Kiện (Elements)" FontSize="11" Foreground="{StaticResource Muted}" FontWeight="Normal"/>
                    <TextBlock Text="{Binding TotalElementsCountDisplay}" FontSize="16" Foreground="{StaticResource Ink}" FontWeight="Normal" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 2: Main Content (Tabs Table + Visual Preview Panel)
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Main TabControl -->
            <TabControl Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1" Padding="8">

            <!-- ───────── TAB 1: BY LEVEL (THEO TẦNG) ───────── -->
            <TabItem Header="By Level (Theo Tầng)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <!-- Table: Level Summaries -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="5">
                        <DataGrid ItemsSource="{Binding LevelSummaries}"
                                  SelectedItem="{Binding SelectedLevelSummary, Mode=TwoWay}"
                                  MouseDoubleClick="OnLevelGridDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tầng (Level)" Binding="{Binding LevelName}" Width="160"/>
                                <DataGridTextColumn Header="Cao Độ" Binding="{Binding ElevationDisplay}" Width="100"/>
                                <DataGridTextColumn Header="Số Lượng" Binding="{Binding ElementCount}" Width="90"/>
                                <DataGridTextColumn Header="Bê Tông (m³)" Binding="{Binding ConcreteVolumeDisplay}" Width="120"/>
                                <DataGridTextColumn Header="Cốp Pha (m²)" Binding="{Binding FormworkAreaDisplay}" Width="120"/>
                                <DataGridTextColumn Header="Thép (Tấn)" Binding="{Binding SteelRebarWeightDisplay}" Width="120"/>
                                <DataGridTextColumn Header="Tổng Thể Tích (m³)" Binding="{Binding TotalVolumeDisplay}" Width="130"/>
                                <DataGridTemplateColumn Header="Action" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Box 3D" Style="{StaticResource BtnRowAction}"
                                                    Command="{Binding DataContext.Box3DCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Splitter Label -->
                    <Grid Grid.Row="1" Margin="0,8,0,4">
                        <TextBlock Text="Chi Tiết Cấu Kiện Trong Tầng Được Chọn (Category Breakdown):"
                                   FontSize="11" Foreground="{StaticResource Muted}" FontWeight="Normal"/>
                    </Grid>

                    <!-- Sub-Table: Categories Breakdown in Selected Level -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="5">
                        <DataGrid ItemsSource="{Binding CurrentLevelBreakdowns}"
                                  MouseDoubleClick="OnCategoryBreakdownDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Loại Cấu Kiện (Category)" Binding="{Binding CategoryName}" Width="200"/>
                                <DataGridTextColumn Header="Số Lượng" Binding="{Binding Count}" Width="100"/>
                                <DataGridTextColumn Header="Thể Tích (m³)" Binding="{Binding TotalVolumeDisplay}" Width="130"/>
                                <DataGridTextColumn Header="Diện Tích (m²)" Binding="{Binding TotalAreaDisplay}" Width="130"/>
                                <DataGridTextColumn Header="Thép / Rebar (Tấn)" Binding="{Binding TotalWeightDisplay}" Width="130"/>
                                <DataGridTemplateColumn Header="Action" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Box 3D" Style="{StaticResource BtnRowAction}"
                                                    Command="{Binding DataContext.Box3DCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ───────── TAB 2: BY CATEGORY (THEO CẤU KIỆN) ───────── -->
            <TabItem Header="By Category (Theo Cấu Kiện)">
                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="5">
                    <DataGrid ItemsSource="{Binding CategorySummaries}"
                              SelectedItem="{Binding SelectedCategorySummary, Mode=TwoWay}"
                              MouseDoubleClick="OnCategoryGridDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Loại Cấu Kiện (Category)" Binding="{Binding CategoryName}" Width="220"/>
                            <DataGridTextColumn Header="Số Lượng" Binding="{Binding Count}" Width="100"/>
                            <DataGridTextColumn Header="Thể Tích (m³)" Binding="{Binding TotalVolumeDisplay}" Width="140"/>
                            <DataGridTextColumn Header="Diện Tích (m²)" Binding="{Binding TotalAreaDisplay}" Width="140"/>
                            <DataGridTextColumn Header="Chiều Dài (m)" Binding="{Binding TotalLength, StringFormat={}{0:N2}}" Width="120"/>
                            <DataGridTextColumn Header="Trọng Lượng (Tấn)" Binding="{Binding TotalWeightDisplay}" Width="140"/>
                            <DataGridTemplateColumn Header="Action" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Box 3D" Style="{StaticResource BtnRowAction}"
                                                Command="{Binding DataContext.Box3DCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- ───────── TAB 3: ELEMENT DETAILS (CHI TIẾT) ───────── -->
            <TabItem Header="Element Details (Chi Tiết Cấu Kiện)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bar for Details -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0" Tag="Tìm kiếm..."/>

                        <!-- Category Filter Dropdown -->
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableCategoryNames}"
                                  SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                                  Margin="0,0,8,0"/>

                        <!-- Level Filter Dropdown -->
                        <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableLevelNames}"
                                  SelectedItem="{Binding SelectedLevelFilter, Mode=TwoWay}"
                                  Margin="0,0,8,0"/>
                    </Grid>

                    <!-- DataGrid of Elements -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="5">
                        <DataGrid ItemsSource="{Binding ElementsView}"
                                  SelectedItem="{Binding SelectedElement, Mode=TwoWay}"
                                  MouseDoubleClick="OnElementGridDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="36">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdValue}" Width="75"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="130"/>
                                <DataGridTextColumn Header="Tầng (Level)" Binding="{Binding LevelName}" Width="110"/>
                                <DataGridTextColumn Header="Family" Binding="{Binding FamilyName}" Width="130"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="140"/>
                                <DataGridTextColumn Header="Mark" Binding="{Binding Mark}" Width="80"/>
                                <DataGridTextColumn Header="Vật Liệu" Binding="{Binding MaterialName}" Width="120"/>
                                <DataGridTextColumn Header="Thể Tích (m³)" Binding="{Binding VolumeDisplay}" Width="100"/>
                                <DataGridTextColumn Header="Diện Tích (m²)" Binding="{Binding AreaDisplay}" Width="100"/>
                                <DataGridTextColumn Header="Chiều Dài (m)" Binding="{Binding LengthDisplay}" Width="95"/>
                                <DataGridTextColumn Header="Thép (Tấn)" Binding="{Binding WeightDisplay}" Width="90"/>
                                <DataGridTemplateColumn Header="Action" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Box 3D" Style="{StaticResource BtnRowAction}"
                                                    Command="{Binding DataContext.Box3DCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

            <!-- Right: Integrated Visual Preview Dashboard -->
            <Border Grid.Column="1" Margin="8,0,0,0" Width="390"
                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVis}}"
                    Background="White" BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header & Mode Switcher -->
                        <RowDefinition Height="*"/>    <!-- Chart Content -->
                        <RowDefinition Height="Auto"/> <!-- Footer Hint -->
                    </Grid.RowDefinitions>

                    <!-- HEADER: Title & Mode Toggle -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                            Padding="10,8" Background="{StaticResource HeaderBg}" CornerRadius="4,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Visual Preview" FontSize="12.5" Foreground="{StaticResource Ink}" FontWeight="Normal"/>
                                <TextBlock Text="Đồ thị khối lượng trực quan" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/>
                            </StackPanel>

                            <!-- Mode Switcher -->
                            <Border Grid.Column="1" Background="#E2E8F0" CornerRadius="4" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="By Level" Command="{Binding SetPreviewModeCommand}" CommandParameter="0"
                                            Style="{StaticResource BtnSegmentLevel}"/>
                                    <Button Content="By Category" Command="{Binding SetPreviewModeCommand}" CommandParameter="1"
                                            Style="{StaticResource BtnSegmentCategory}" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ROW 1: CONTENT -->
                    <Grid Grid.Row="1" Margin="8">
                        <!-- MODE 0: BY LEVEL (Elevation Stack Chart) -->
                        <Grid Visibility="{Binding IsLevelPreviewMode, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="4,0,4,6">
                                <TextBlock Text="Mặt Đứng Khối Lượng Tòa Nhà (Elevation Stack):"
                                           FontSize="11" Foreground="{StaticResource Muted}" FontWeight="Normal"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding LevelChartItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:LevelChartItem}">
                                            <Border Margin="0,2" Padding="8,6" CornerRadius="4" BorderThickness="1" Cursor="Hand"
                                                    ToolTip="{Binding TooltipText}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                                <Setter Property="BorderBrush" Value="#93C5FD"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#EFF6FF"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.SelectChartLevelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding LevelName}"
                                                                   FontSize="11.5" Foreground="{StaticResource Ink}" FontWeight="Normal"
                                                                   VerticalAlignment="Center"/>

                                                        <Border Grid.Column="1" Background="#E2E8F0" CornerRadius="3"
                                                                Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ElevationDisplay}" FontSize="10" Foreground="{StaticResource Muted}"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding VolumeDisplay}" FontSize="11" Foreground="{StaticResource Accent}" FontWeight="Normal"/>
                                                            <TextBlock Text="{Binding PercentageDisplay, StringFormat=' ({0})'}" FontSize="10" Foreground="{StaticResource Muted}"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="3" Content="Box 3D" Style="{StaticResource BtnRowAction}"
                                                                Command="{Binding DataContext.Box3DCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" ToolTip="Tạo Section Box 3D cho tầng này"/>
                                                    </Grid>

                                                    <ProgressBar Grid.Row="1" Height="8"
                                                                 Template="{StaticResource FlatProgressBar}"
                                                                 Background="#E2E8F0" Foreground="#0284C7"
                                                                 Value="{Binding RelativePercentage}" Maximum="100"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- MODE 1: BY CATEGORY (Category Share Chart) -->
                        <Grid Visibility="{Binding IsCategoryPreviewMode, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="4,0,4,6">
                                <TextBlock Text="Phân Bổ Khối Lượng Theo Cấu Kiện (Category Share):"
                                           FontSize="11" Foreground="{StaticResource Muted}" FontWeight="Normal"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding CategoryChartItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:CategoryChartItem}">
                                            <Border Margin="0,3" Padding="8,6" CornerRadius="4" BorderThickness="1"
                                                    Background="#F8FAFC" BorderBrush="#E2E8F0" ToolTip="{Binding TooltipText}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Width="8" Height="8" CornerRadius="2"
                                                                Background="{Binding ColorBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CategoryName}" FontSize="11.5" Foreground="{StaticResource Ink}" FontWeight="Normal"/>
                                                            <TextBlock Text="{Binding ElementCount, StringFormat=' ({0})'}" FontSize="10" Foreground="{StaticResource Muted}" Margin="4,0,0,0"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2" Text="{Binding VolumeDisplay}"
                                                                   FontSize="11" Foreground="{StaticResource Ink}" FontWeight="Normal"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                        <Button Grid.Column="3" Content="Box 3D" Style="{StaticResource BtnRowAction}"
                                                                Command="{Binding DataContext.Box3DCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" ToolTip="Tạo Section Box 3D cho cấu kiện này"/>
                                                    </Grid>

                                                    <ProgressBar Grid.Row="1" Height="8"
                                                                 Template="{StaticResource FlatProgressBar}"
                                                                 Background="#E2E8F0" Foreground="{Binding ColorBrush}"
                                                                 Value="{Binding Percentage}" Maximum="100"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ROW 2: FOOTER -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0"
                            Padding="8,6" Background="#FAFAFA" CornerRadius="0,0,4,4">
                        <TextBlock Text="💡 Click chọn tầng để đồng bộ bảng • Bấm Box 3D để xem mô hình"
                                   FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 3: Bottom Status Bar
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                       FontSize="11" Foreground="{StaticResource Muted}" FontWeight="Normal"
                       VerticalAlignment="Center"/>

            <ProgressBar Grid.Column="1" Width="100" Height="14" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                         Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</Window>
