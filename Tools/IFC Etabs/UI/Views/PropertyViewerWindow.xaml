<Window x:Class="JNNTool.Tools.IFCEtabs.UI.Views.PropertyViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:JNNTool.Tools.IFCEtabs.UI.ViewModels"
        mc:Ignorable="d"
        Title="JNN Property Viewer - Truy Xuất Nguồn Cấu Kiện"
        Height="580" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.DataContext>
        <vm:PropertyViewerViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#00AEEF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Pick button -->
            <RowDefinition Height="Auto"/> <!-- Source Summary Card -->
            <RowDefinition Height="*"/>    <!-- Detailed Parameters Grid -->
        </Grid.RowDefinitions>

        <!-- 1. Header & Pick -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding ElementName}" FontWeight="Bold" Foreground="#00AEEF" FontSize="14" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding ElementCategory}" Foreground="#888888" FontSize="11"/>
            </StackPanel>

            <Button Grid.Column="1" Content="🔍 Chọn Cấu Kiện Khác" Command="{Binding PickElementCommand}" Height="32" Background="#0E639C"/>
        </Grid>

        <!-- 2. Source Summary -->
        <GroupBox Grid.Row="1" Header="THÔNG TIN NGUỒN (TRACEABILITY)">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nguồn dữ liệu:" Foreground="#888888" Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Source}" FontWeight="Bold" Foreground="#00FFCC" Margin="0,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Mã ID gốc:" Foreground="#888888" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SourceId}" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Tiết diện nguồn:" Foreground="#888888" Margin="0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Section}" Foreground="#FFCC00" Margin="0,2"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Vật liệu / Tầng:" Foreground="#888888" Margin="0,2"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,2">
                    <Run Text="{Binding Material, Mode=OneWay}"/>
                    <Run Text=" / " Foreground="#888888"/>
                    <Run Text="{Binding Story, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Mã Hash:" Foreground="#888888" Margin="0,2"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SourceHash}" FontFamily="Consolas" Foreground="#AAAAAA" Margin="0,2"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Trạng thái:" Foreground="#888888" Margin="0,2"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Status}" Foreground="#00AEEF" Margin="0,2"/>
            </Grid>
        </GroupBox>

        <!-- 3. All Element Parameters -->
        <GroupBox Grid.Row="2" Header="DANH SÁCH THAM SỐ CẤU KIỆN">
            <DataGrid ItemsSource="{Binding AllProperties}" AutoGenerateColumns="False" 
                      IsReadOnly="True" Background="#252526" Foreground="#E0E0E0"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46"
                      BorderThickness="0" HeadersVisibility="Column" RowHeight="24">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2D2D30"/>
                        <Setter Property="Foreground" Value="#00AEEF"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#3F3F46"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên tham số" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="Giá trị" Binding="{Binding Value}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>
