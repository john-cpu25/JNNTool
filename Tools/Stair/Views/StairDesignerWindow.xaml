<Window x:Class="JNN.Stair.Views.StairDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:JNN.Stair.ViewModels"
        mc:Ignorable="d"
        Title="Stair Family Designer" 
        Height="780" Width="1180" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7F9"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="#2C3E50"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Bảng màu chuẩn mực JNN Tool -->
        <SolidColorBrush x:Key="Accent" Color="#2E5C9A"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1B3B6F"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#E67E22"/>
        <SolidColorBrush x:Key="AccentOrangeHover" Color="#D35400"/>
        <SolidColorBrush x:Key="Border" Color="#DCDDE1"/>
        <SolidColorBrush x:Key="Muted" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="Ink" Color="#2C3E50"/>

        <!-- Section Label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Modern TextBox với CornerRadius 5 & Normal font weight -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox với CornerRadius 5 & Dropdown nền trắng rõ nét -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="5">
                <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,8,0" Fill="#7F8C8D" Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,0,24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="White"
                                            BorderBrush="{StaticResource Border}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Margin="0,2,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.10" Color="#0F172A"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="0,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Clean Toolbar Button Style (Bo góc 5px) -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Primary Button Style (Bo góc 5px) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Secondary Button Style (Bo góc 5px) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean TabItem với CornerRadius 5,5,0,0 & Normal font weight -->
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="#F5F7F9"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="5,5,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                <Setter TargetName="bd" Property="Margin" Value="0,0,3,-1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean TabControl với CornerRadius 0,5,5,5 -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Panel.ZIndex="1" Margin="2,0,0,0"/>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="0,5,5,5">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container Layout -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. WORK AREA -->
        <Grid Grid.Row="0" Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/> <!-- Left Config Sidebar -->
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>   <!-- Right Content Area -->
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR CARD -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="5" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="STAIR PARAMETERS" Style="{StaticResource SectionLabel}"/>

                        <Label Content="Output Type:"/>
                        <ComboBox ItemsSource="{Binding OutputObjectTypes}" SelectedItem="{Binding SelectedOutputType}" Margin="0,0,0,6"/>

                        <Label Content="Stair Geometry:"/>
                        <ComboBox ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding SelectedPresetText}" Margin="0,0,0,6"/>

                        <Label Content="Riser Calculation Mode:"/>
                        <ComboBox ItemsSource="{Binding InputModeOptions}" SelectedItem="{Binding SelectedInputModeText}" Margin="0,0,0,8"/>

                        <Separator Background="{StaticResource Border}" Margin="0,4,0,8"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="Flight Count:"/>
                            <TextBox Grid.Column="1" Text="{Binding Layout.FlightCount, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="Floor Height (mm):"/>
                            <TextBox Grid.Column="1" Text="{Binding Layout.FloorToFloorMm, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="Stair Width (mm):"/>
                            <TextBox Grid.Column="1" Text="{Binding Layout.StairWidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="Preferred Riser (mm):"/>
                            <TextBox Grid.Column="1" Text="{Binding Layout.PreferredRiserMm, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="Flight 1 Risers:"/>
                            <TextBox Grid.Column="1" Text="{Binding Layout.CustomRisersFlight1, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="Flight 2 Risers:"/>
                            <TextBox Grid.Column="1" Text="{Binding Layout.CustomRisersFlight2, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="Flight 3 Risers:"/>
                            <TextBox Grid.Column="1" Text="{Binding Layout.CustomRisersFlight3, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="Tread Width (mm):"/>
                            <TextBox Grid.Column="1" Text="{Binding Layout.TreadMm, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="Landing Depth (mm):"/>
                            <TextBox Grid.Column="1" Text="{Binding Layout.LandingDepthMm, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="Waist Thickness (mm):"/>
                            <TextBox Grid.Column="1" Text="{Binding Layout.WaistThicknessMm, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="Mortar Bedding (mm):"/>
                            <TextBox Grid.Column="1" Text="{Binding Layout.MortarThicknessMm, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="Flight Gap (mm):"/>
                            <TextBox Grid.Column="1" Text="{Binding Layout.FlightGapMm, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Separator Background="{StaticResource Border}" Margin="0,4,0,8"/>

                        <TextBlock Text="PLAN ORIENTATION" Style="{StaticResource SectionLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="Rotation Angle (°):"/>
                            <TextBox Grid.Column="1" Text="{Binding PlanRotationDeg, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <CheckBox Content="Mirror Stair in Plan" IsChecked="{Binding PlanMirrored}"/>
                        <CheckBox Content="Reverse Up Direction" IsChecked="{Binding ReverseDirection}"/>

                        <Separator Background="{StaticResource Border}" Margin="0,6,0,8"/>

                        <TextBlock Text="LANDING BEAM" Style="{StaticResource SectionLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="Beam Width (mm):"/>
                            <TextBox Grid.Column="1" Text="{Binding Layout.LandingBeamWidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="Beam Height (mm):"/>
                            <TextBox Grid.Column="1" Text="{Binding Layout.LandingBeamHeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Separator Background="{StaticResource Border}" Margin="0,4,0,8"/>

                        <!-- CÔNG CỤ HỖ TRỢ -->
                        <TextBlock Text="TOOLS &amp; SCANNING" Style="{StaticResource SectionLabel}"/>
                        <UniformGrid Columns="3" Margin="0,0,0,4">
                            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Place Beam"/>
                            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Delete Beam"/>
                            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Read Stair"/>
                        </UniformGrid>
                        <UniformGrid Columns="3" Margin="0,0,0,4">
                            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Stair Link"/>
                            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Detail Line"/>
                            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Get Data"/>
                        </UniformGrid>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Content="Check Plan Boundary" Margin="2,0,2,8"/>

                        <!-- NÚT CẬP NHẬT XEM TRƯỚC -->
                        <Button Content="🔄 Update Preview" Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,4,0,8" Click="BtnUpdatePreview_Click"/>

                        <!-- BẢNG TỔNG HỢP TÍNH TOÁN -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="5" Padding="8">
                            <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource Muted}" LineHeight="18" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT CONTENT AREA (4 TABS) -->
            <Grid Grid.Column="2">
                <TabControl x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
                    <!-- TAB 1: 2D PLAN & DIMENSIONS -->
                    <TabItem Header="2D Plan &amp; Dimensions">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Content="🔍 Zoom Extents" HorizontalAlignment="Right" Width="100" Height="26"
                                    Style="{StaticResource ToolbarButtonStyle}" Click="BtnFitPlan_Click"/>

                            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="5" ClipToBounds="True" Margin="0,6,0,6">
                                <Canvas x:Name="PlanCanvas" Background="Transparent" SizeChanged="PlanCanvas_SizeChanged"/>
                            </Border>

                            <TextBlock Grid.Row="2" Text="Blue: Flight • Light Blue: Landing &amp; Winders • Orange: Dimensions • Arrow: Walkline direction"
                                       Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: 2D SECTION & BUILD-UP -->
                    <TabItem Header="2D Section &amp; Build-up">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Select Section View:" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableSections}" SelectedItem="{Binding SelectedSection}"/>
                                <Button Grid.Column="3" Content="🔍 Zoom Extents" Width="100" Height="26"
                                        Style="{StaticResource ToolbarButtonStyle}" Click="BtnFitSection_Click"/>
                            </Grid>

                            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="5" ClipToBounds="True" Margin="0,6,0,6">
                                <Grid>
                                    <Canvas x:Name="SectionCanvas" Background="Transparent" SizeChanged="SectionCanvas_SizeChanged"/>

                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Background="White"
                                            BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="5" Padding="10">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.08" Color="#0F172A"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="STAIR BUILD-UP STRUCTURE:" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                            <TextBlock Text="1. Step Topping / Brick" Foreground="#7C3AED" Margin="0,2"/>
                                            <TextBlock Text="2. Mortar Bedding 20mm" Foreground="#D97706" Margin="0,2"/>
                                            <TextBlock Text="3. Structural Slab Concrete" Foreground="{StaticResource Accent}" Margin="0,2"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="2" Text="Blue: Structural Slab • Orange: Mortar Bedding • Purple: Brick Steps • Brown: Treads finish"
                                       Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
                        </Grid>
                    </TabItem>

                    <!-- TAB 3: 3D VIEWPORT -->
                    <TabItem Header="3D Viewport">
                        <Grid Margin="10">
                            <Border Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                        <Button Content="Reset Camera" Width="100" Style="{StaticResource ToolbarButtonStyle}"/>
                                    </StackPanel>

                                    <TextBlock Text="[3D Viewport — Decoupled Geometry Simulation]" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>

                                    <TextBlock Text="Drag with mouse to rotate • Scroll to zoom • Real-time coordinate updates"
                                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{StaticResource Muted}" FontSize="11"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 4: GENERATE VIEWS -->
                    <TabItem Header="Generate Views">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                            <Border Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="5" Padding="16">
                                <StackPanel MaxWidth="580" HorizontalAlignment="Left">
                                    <TextBlock Text="AUTOMATIC STAIR VIEWS GENERATION" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Generate plans and section views for native stairs or loaded families." 
                                               Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>

                                    <Label Content="Structural Plan Type:"/>
                                    <ComboBox Margin="0,0,0,8"/>

                                    <Label Content="Detail View Type for Sections:"/>
                                    <ComboBox Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label Content="Template Structural Plan:"/>
                                            <ComboBox/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label Content="Template Detail View:"/>
                                            <ComboBox/>
                                        </StackPanel>
                                    </Grid>

                                    <Label Content="Plan View Naming:"/>
                                    <TextBox Text="{Binding PlanNamePattern}" Margin="0,0,0,8"/>

                                    <Label Content="Section View Naming:"/>
                                    <TextBox Text="{Binding SectionNamePattern}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Available Tokens: {Stair}, {Level}, {Index}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label Content="Plan Scale:"/>
                                            <TextBox Text="{Binding PlanScale}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label Content="Section Scale:"/>
                                            <TextBox Text="{Binding SectionScale}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label Content="Crop Offset (mm):"/>
                                            <TextBox Text="{Binding CropOffsetMm}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label Content="Far Clip Offset (mm):"/>
                                            <TextBox Text="{Binding FarClipOffsetMm}"/>
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox Content="Annotate riser numbers with Text Notes" IsChecked="{Binding IncludeTextNotes}"/>
                                    <CheckBox Content="Draw path and UP arrow direction" IsChecked="{Binding IncludeDirectionArrow}"/>

                                    <Button Content="📐 Create Stair Views" Style="{StaticResource PrimaryButtonStyle}" Width="160" HorizontalAlignment="Right" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- 2. BOTTOM ACTION BAR (CARD NỀN TRẮNG PHẲNG) -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,10" Margin="0,10,0,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                    <TextBlock Text="Parameters valid. Ready to generate." Foreground="{StaticResource Muted}" FontSize="11.5"/>
                </StackPanel>

                <!-- Type Name When Load -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Content="Family Type Name:" Margin="0,0,6,0"/>
                    <TextBox Width="180" Text="{Binding TypeNameToLoad}"/>
                </StackPanel>

                <!-- Create and Place in Project -->
                <Button Grid.Column="4" Style="{StaticResource PrimaryButtonStyle}" Content="➕ Create &amp; Place in Project" Width="190" Click="BtnCreateAndPlace_Click"/>

                <!-- Export RFA -->
                <Button Grid.Column="6" Content="💾 Export Family (.rfa)" Width="150" Style="{StaticResource SecondaryButtonStyle}" Click="BtnExportRfa_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
