<Window x:Class="JNNTool.Tools.ElementMark.Views.ElementMarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JNN — Element Mark (Beam · Column · Floor)"
        Height="660" Width="1120" MinHeight="540" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7F9"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="#2C3E50"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2E5C9A"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#E67E22"/>
        <SolidColorBrush x:Key="AccentOrangeHover" Color="#D35400"/>
        <SolidColorBrush x:Key="Border" Color="#DCDDE1"/>
        <SolidColorBrush x:Key="Muted" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="Ink" Color="#2C3E50"/>

        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Modern TextBox with CornerRadius 5 & Normal font weight -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox with CornerRadius 5 & Normal font weight -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="5">
                <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,8,0" Fill="#7F8C8D" Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="6,0,24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="White"
                                            BorderBrush="{StaticResource Border}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Margin="0,2,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.10" Color="#0F172A"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- Clean GroupBox with CornerRadius 5 & Normal font weight (no heavy bold header) -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#F8FAFC"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="5,5,0,0"
                                        Padding="10,5">
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      TextElement.FontWeight="Normal"
                                                      TextElement.Foreground="{StaticResource Ink}"/>
                                </Border>
                                <Border Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExampleBox" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Clean Button with CornerRadius 5 & Normal font weight -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentOrange}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentOrange}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentOrangeHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean TabItem with CornerRadius 5 & Normal font weight -->
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="#F5F7F9"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="5,5,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                <Setter TargetName="bd" Property="Margin" Value="0,0,3,-1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean TabControl with CornerRadius 5 -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Panel.ZIndex="1" Margin="2,0,0,0"/>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="0,5,5,5">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Column Header Style (Clean & Normal font weight) -->
        <Style x:Key="CleanColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F7F9"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Body: 2 Columns -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═════════════ Left Column: Settings ═════════════ -->
            <DockPanel Grid.Column="0">
                <GroupBox DockPanel.Dock="Top" Header="General" Background="White">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="Scope"/>
                        <ComboBox x:Name="cbScope" Grid.Column="1" ItemsSource="{Binding ScopeOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Scope}"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Existing Mark"/>
                        <ComboBox x:Name="cbOverwrite" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding OverwriteOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Overwrite}"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Target Parameter"/>
                        <TextBox x:Name="txtTargetParam" Grid.Row="2" Grid.Column="1"
                                 Text="{Binding TargetParameter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Default is 'Mark'. Can enter any instance Text parameter name."/>
                    </Grid>
                </GroupBox>

                <TabControl Background="White" BorderBrush="{StaticResource Border}">

                    <!-- ───── Tab Beam ───── -->
                    <TabItem Header="Beam">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                            <StackPanel>
                                <CheckBox x:Name="chkBeam" Content="Renumber Beams (Structural Framing)"
                                          IsChecked="{Binding BeamEnabled}" Margin="0,0,0,10"/>

                                <StackPanel IsEnabled="{Binding BeamEnabled}">
                                    <Border Style="{StaticResource ExampleBox}">
                                        <StackPanel>
                                            <TextBlock Text="Preview" Style="{StaticResource Hint}"/>
                                            <TextBlock Text="{Binding BeamExample}" FontFamily="Consolas" FontSize="13"
                                                       Foreground="#2E5C9A" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <GroupBox Header="Mark Pattern">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Prefix {P}"/>
                                            <TextBox x:Name="txtBeamPrefix" Grid.Column="1" Text="{Binding BeamPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Column="3" Style="{StaticResource Label}" Text="Start No."/>
                                            <TextBox x:Name="txtBeamStart" Grid.Column="4" Text="{Binding BeamStartNumber, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Template"/>
                                            <TextBox x:Name="txtBeamTemplate" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" FontFamily="Consolas"
                                                     Text="{Binding BeamTemplate, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Axis X / Y {D}"/>
                                            <Grid Grid.Row="2" Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtAxisX" Text="{Binding BeamAxisXCode, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox x:Name="txtAxisY" Grid.Column="2" Text="{Binding BeamAxisYCode, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource Label}" Text="Span Suffix"/>
                                            <TextBox x:Name="txtSpanSuffix" Grid.Row="2" Grid.Column="4" FontFamily="Consolas"
                                                     Text="{Binding BeamSpanSuffix, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Appended to continuous multi-span beams only. {S} = span number."/>

                                            <TextBlock Grid.Row="3" Grid.ColumnSpan="5" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                       Text="{}{P} Prefix · {L} Level · {D} Axis · {N} Number · {N:00} 2-digit pad · {S} Span no. Angle ≤ 45° → X, > 45° → Y."/>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="Numbering Direction">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Vertical"/>
                                            <ComboBox x:Name="cbBeamVertical" Grid.Column="1" ItemsSource="{Binding VerticalOptions}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding BeamVertical}"/>
                                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Horizontal"/>
                                            <ComboBox x:Name="cbBeamHorizontal" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding HorizontalOptions}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding BeamHorizontal}"/>
                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                       Text="X beams: ordered by rows (vertical), then along row (horizontal). Y beams: ordered by columns (horizontal), then along column (vertical)."/>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="Continuous Beam Spans">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="32"/>
                                            </Grid.RowDefinitions>
                                            <CheckBox x:Name="chkMergeSpans" Grid.ColumnSpan="2" IsChecked="{Binding BeamMergeSpans}"
                                                      Content="Merge collinear spans into continuous beam (DS1X01.1, .2 …)"/>
                                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Max span gap (mm)"/>
                                            <TextBox x:Name="txtChainGap" Grid.Row="1" Grid.Column="1" IsEnabled="{Binding BeamMergeSpans}"
                                                     Text="{Binding BeamChainGapMm, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Typically max column width. Gaps larger than this will start a new beam."/>
                                            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Row tolerance (mm)"/>
                                            <TextBox x:Name="txtRowTol" Grid.Row="2" Grid.Column="1"
                                                     Text="{Binding BeamRowToleranceMm, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </GroupBox>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ───── Tab Column ───── -->
                    <TabItem Header="Column">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                            <StackPanel>
                                <CheckBox x:Name="chkColumn" Content="Renumber Columns (Structural Column)"
                                          IsChecked="{Binding ColumnEnabled}" Margin="0,0,0,10"/>

                                <StackPanel IsEnabled="{Binding ColumnEnabled}">
                                    <Border Style="{StaticResource ExampleBox}">
                                        <StackPanel>
                                            <TextBlock Text="Preview" Style="{StaticResource Hint}"/>
                                            <TextBlock Text="{Binding ColumnExample}" FontFamily="Consolas" FontSize="13"
                                                       Foreground="#2E5C9A" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <GroupBox Header="Mark Pattern">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="32"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Prefix {P}"/>
                                            <TextBox x:Name="txtColPrefix" Grid.Column="1" Text="{Binding ColumnPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Column="3" Style="{StaticResource Label}" Text="Start No."/>
                                            <TextBox x:Name="txtColStart" Grid.Column="4" Text="{Binding ColumnStartNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Template"/>
                                            <TextBox x:Name="txtColTemplate" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" FontFamily="Consolas"
                                                     Text="{Binding ColumnTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="Numbering Direction">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="32"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Priority"/>
                                            <ComboBox x:Name="cbColPriority" Grid.Column="1" ItemsSource="{Binding PriorityOptions}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ColumnPriority}"/>
                                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Vertical"/>
                                            <ComboBox x:Name="cbColVertical" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding VerticalOptions}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ColumnVertical}"/>
                                            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Horizontal"/>
                                            <ComboBox x:Name="cbColHorizontal" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding HorizontalOptions}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ColumnHorizontal}"/>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="Column Stack (Foundation to Roof)">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Max eccentricity (mm)"/>
                                            <TextBox x:Name="txtStackTol" Grid.Column="1" Text="{Binding ColumnStackToleranceMm, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Row tolerance (mm)"/>
                                            <TextBox x:Name="txtColRowTol" Grid.Row="1" Grid.Column="1" Text="{Binding ColumnRowToleranceMm, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                       Text="Columns sharing the same position across levels share the same Mark. Select 'Entire Project' scope to include all levels."/>
                                        </Grid>
                                    </GroupBox>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ───── Tab Floor ───── -->
                    <TabItem Header="Floor">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                            <StackPanel>
                                <CheckBox x:Name="chkFloor" Content="Renumber Floors (Floor)"
                                          IsChecked="{Binding FloorEnabled}" Margin="0,0,0,10"/>

                                <StackPanel IsEnabled="{Binding FloorEnabled}">
                                    <Border Style="{StaticResource ExampleBox}">
                                        <StackPanel>
                                            <TextBlock Text="Preview" Style="{StaticResource Hint}"/>
                                            <TextBlock Text="{Binding FloorExample}" FontFamily="Consolas" FontSize="13"
                                                       Foreground="#2E5C9A" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <GroupBox Header="Mark Pattern">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Prefix {P}"/>
                                            <TextBox x:Name="txtFloorPrefix" Grid.Column="1" Text="{Binding FloorPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Template"/>
                                            <TextBox x:Name="txtFloorTemplate" Grid.Row="1" Grid.Column="1" FontFamily="Consolas"
                                                     Text="{Binding FloorTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                            <CheckBox x:Name="chkFloorStructural" Grid.Row="2" Grid.ColumnSpan="2"
                                                      IsChecked="{Binding FloorStructuralOnly}" Content="Structural floors only (Structural = Yes)"/>
                                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                       Text="All floors on the same level share the same Mark (e.g. S1 for Level 1)."/>
                                        </Grid>
                                    </GroupBox>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ───── Tab Level Codes ───── -->
                    <TabItem Header="Level Codes {L}">
                        <DockPanel Margin="10">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="Level codes are suggested from level names. Edit the 'Code' column if needed (e.g. Basement 1 → B1, Roof → R)."/>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button x:Name="btnSuggestCodes" Style="{StaticResource BaseButton}" Content="Suggest from Name"
                                        Command="{Binding SuggestLevelCodesCommand}"/>
                                <Button x:Name="btnReloadLevels" Style="{StaticResource BaseButton}" Content="Reload Levels"
                                        Command="{Binding ReloadLevelsCommand}"/>
                            </StackPanel>
                            <DataGrid x:Name="dgLevels" ItemsSource="{Binding LevelCodes}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F0F0"
                                      BorderBrush="{StaticResource Border}" Background="White" RowHeight="26"
                                      ColumnHeaderStyle="{StaticResource CleanColumnHeaderStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Level" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                                    <DataGridTextColumn Header="Elevation (mm)" Binding="{Binding ElevationText}" IsReadOnly="True" Width="95"/>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>

            <!-- ═════════════ Right Column: Preview ═════════════ -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="5">
                <DockPanel Margin="12">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Preview" FontSize="13" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="{Binding PreviewSummary}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Filter" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                            <ComboBox x:Name="cbFilter" Width="110" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding PreviewFilter}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Click a row to select the element in Revit."/>

                    <DataGrid x:Name="dgPreview" ItemsSource="{Binding PreviewView}" SelectedItem="{Binding SelectedPreviewRow}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F0F0"
                              BorderThickness="0" Background="White" RowHeight="26" AlternatingRowBackground="#F8FAFC"
                              ColumnHeaderStyle="{StaticResource CleanColumnHeaderStyle}"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WillWrite}" Value="False">
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryLabel}" Width="65"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" Width="110"/>
                            <DataGridTextColumn Header="Axis" Binding="{Binding Axis}" Width="50"/>
                            <DataGridTextColumn Header="Family / Type" Binding="{Binding TypeName}" Width="*"/>
                            <DataGridTextColumn Header="Current Mark" Binding="{Binding OldMark}" Width="90"/>
                            <DataGridTextColumn Header="New Mark" Binding="{Binding NewMark}" Width="100" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bottom Bar: Status & Actions -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#22C55E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Fill" Value="#F59E0B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnReset" Style="{StaticResource BaseButton}" Content="Reset Defaults" Command="{Binding ResetDefaultsCommand}"/>
                <Button x:Name="btnPreview" Style="{StaticResource BaseButton}" Content="Preview" Command="{Binding PreviewCommand}"/>
                <Button x:Name="btnApply" Style="{StaticResource PrimaryButton}" Content="Apply" Command="{Binding ApplyCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
