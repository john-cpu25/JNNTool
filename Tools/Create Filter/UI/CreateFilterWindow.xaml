<Window x:Class="JNNTool.Tools.CreateFilter.UI.CreateFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:JNNTool.Tools.CreateFilter.Models"
        mc:Ignorable="d"
        Title="Batch Create Filters" Height="450" Width="950"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Create multiple filters and apply them to the active view." FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Categories Mode:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton Content="Current View" IsChecked="{Binding IsCategoryModeCurrentView}" Margin="0,0,15,0" VerticalAlignment="Center"/>
            <RadioButton Content="Project" IsChecked="{Binding IsCategoryModeProject}" VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding FilterRows}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <!-- Filter Name -->
                <DataGridTextColumn Header="Filter Name" Binding="{Binding FilterName, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                
                <!-- Category -->
                <DataGridTemplateColumn Header="Category" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding AvailableCategories}" 
                                      SelectedItem="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Name"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Parameter -->
                <DataGridTemplateColumn Header="Parameter" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding AvailableParameters}" 
                                      SelectedItem="{Binding SelectedParameter, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Name"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Condition -->
                <DataGridTemplateColumn Header="Condition" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Conditions}" 
                                      SelectedItem="{Binding SelectedCondition, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Value -->
                <DataGridTextColumn Header="Value" Binding="{Binding FilterValue, UpdateSourceTrigger=PropertyChanged}" Width="120"/>

                <!-- Color -->
                <DataGridTemplateColumn Header="Color" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="16" Height="16" Margin="0,0,5,0" Stroke="Gray">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding WpfColor}"/>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Actions -->
                <DataGridTemplateColumn Header="Actions" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Custom Color" Command="{Binding SelectCustomColorCommand}" Margin="0,0,5,0" Padding="5,0"/>
                                <Button Content="Remove" 
                                        Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Padding="5,0" Foreground="Red"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Add Row" Command="{Binding AddRowCommand}" Width="100" Height="30" Margin="0,0,10,0"/>
            <Button Content="Create &amp; Apply Filters" Command="{Binding ApplyFiltersCommand}" Width="150" Height="30" Background="#007ACC" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
