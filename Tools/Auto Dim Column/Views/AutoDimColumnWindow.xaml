<Window x:Class="JNNTool.Tools.AutoDimColumn.Views.AutoDimColumnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JNN — Auto Column Dimension"
        Height="620" Width="1060" MinHeight="520" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7F9"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="#2C3E50"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2E5C9A"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#E67E22"/>
        <SolidColorBrush x:Key="AccentOrangeHover" Color="#D35400"/>
        <SolidColorBrush x:Key="Border" Color="#DCDDE1"/>
        <SolidColorBrush x:Key="Muted" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="Ink" Color="#2C3E50"/>

        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Modern TextBox with CornerRadius 5 & Normal font weight -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox with CornerRadius 5 & Normal font weight -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="5">
                <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,8,0" Fill="#7F8C8D" Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="6,0,24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="White"
                                            BorderBrush="{StaticResource Border}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Margin="0,2,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.10" Color="#0F172A"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- Clean GroupBox with CornerRadius 5 & Normal font weight (no heavy bold) -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#F8FAFC"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="5,5,0,0"
                                        Padding="10,5">
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      TextElement.FontWeight="Normal"
                                                      TextElement.Foreground="{StaticResource Ink}"/>
                                </Border>
                                <Border Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Button with CornerRadius 5 & Normal font weight -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentOrange}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentOrange}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentOrangeHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="75"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0F2FE"/>
                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Content Area: Left Settings + Right Preview -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: SETTINGS -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <!-- 1. Scope Target -->
                    <GroupBox Header="Target Columns">
                        <StackPanel Margin="0,4,0,2">
                            <RadioButton Content="All Columns in Active View"
                                         IsChecked="{Binding ScopeModeIndex, ConverterParameter=0, Mode=TwoWay, Converter={x:Null}}"
                                         GroupName="ScopeGroup" Margin="0,2,0,6"/>
                            <RadioButton Content="Selected Columns"
                                         IsChecked="{Binding ScopeModeIndex, ConverterParameter=1, Mode=TwoWay, Converter={x:Null}}"
                                         GroupName="ScopeGroup" Margin="0,0,0,4"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 2. Dimension Options -->
                    <GroupBox Header="Dimension Options">
                        <StackPanel Margin="0,4,0,2">
                            <CheckBox Content="Column Width (b)" IsChecked="{Binding DimWidth}" Margin="0,2,0,6"/>
                            <CheckBox Content="Column Length (h)" IsChecked="{Binding DimLength}" Margin="0,0,0,6"/>
                            <CheckBox Content="Grid to Column Face" IsChecked="{Binding DimGridToColumn}" Margin="0,0,0,6"/>
                            <CheckBox Content="Include Opposite Face (Chain)" IsChecked="{Binding IncludeOppositeFace}"
                                      IsEnabled="{Binding DimGridToColumn}" Margin="18,0,0,6"/>
                            <CheckBox Content="Skip Existing Dimensions" IsChecked="{Binding SkipExisting}" Margin="0,4,0,2"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 3. Placement & Spacing -->
                    <GroupBox Header="Placement &amp; Spacing">
                        <Grid Margin="0,4,0,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Dimension Type:" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DimensionTypes}"
                                      SelectedItem="{Binding SelectedDimensionType}" DisplayMemberPath="Name" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Placement Side:" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding PlacementSides}"
                                      SelectedItem="{Binding SelectedPlacementSide}" DisplayMemberPath="Label" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Base Offset (mm):" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BaseOffsetMm, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Chain Spacing (mm):" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ChainSpacingMm, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Grid Search Range (mm):" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding GridSearchRangeMm, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"/>
                        </Grid>
                    </GroupBox>

                    <!-- Reset to Defaults Button -->
                    <Button Content="Reset to Defaults" Command="{Binding ResetSettingsCommand}" Style="{StaticResource BaseButton}"
                            HorizontalAlignment="Left" Margin="0,2,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT PANEL: PREVIEW & QA -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar above DataGrid -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Preview &amp; Candidate Columns" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Background="#F1F5F9" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="5" Padding="8,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total: " Style="{StaticResource Label}" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding TotalColumnsCount}" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                <TextBlock Text="Ready: " Style="{StaticResource Label}" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding ReadyColumnsCount}" Style="{StaticResource Label}" Foreground="#16A34A" Margin="0,0,8,0"/>
                                <TextBlock Text="Skipped: " Style="{StaticResource Label}" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding SkippedCount}" Style="{StaticResource Label}" Foreground="#DC2626" Margin="0,0,8,0"/>
                                <TextBlock Text="Planned Dims: " Style="{StaticResource Label}" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding PlannedDimsCount}" Style="{StaticResource Label}" Foreground="{StaticResource Accent}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Check All" Command="{Binding SelectAllCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                        <Button Content="Uncheck All" Command="{Binding UnselectAllCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                        <Button Content="Refresh" Command="{Binding PreviewCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                    </StackPanel>
                </DockPanel>

                <!-- DataGrid -->
                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="5">
                    <DataGrid ItemsSource="{Binding PreviewItems}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Use" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                            <DataGridTextColumn Header="Mark" Binding="{Binding Mark}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Id" Binding="{Binding IdText}" Width="65" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Size (b × h)" Binding="{Binding SizeText}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Rotation" Binding="{Binding RotationText}" Width="65" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Associated Grids" Binding="{Binding GridsText}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Planned Dims" Binding="{Binding PlannedDimsCount}" Width="85" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- FOOTER: STATUS BAR + ACTIONS -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="5" Padding="10,6" Margin="0,10,0,0">
            <DockPanel>
                <!-- Status text -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Label}" Foreground="{StaticResource Ink}"/>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Preview" Command="{Binding PreviewCommand}" Style="{StaticResource BaseButton}"/>
                    <Button Content="Create Dimensions" Command="{Binding CreateDimensionsCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="Close" Click="BtnClose_Click" Style="{StaticResource BaseButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
