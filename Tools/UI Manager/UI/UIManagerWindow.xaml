<Window x:Class="JNNTool.Tools.UIManager.UI.UIManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:JNNTool.Tools.UIManager.Models"
        mc:Ignorable="d"
        Title="JNNTool — Ribbon Theme &amp; Icon Manager" 
        Height="620" Width="960"
        MinHeight="520" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="12"
        Background="#F5F7F9"
        Foreground="#2C3E50"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Standard Color Tokens -->
        <SolidColorBrush x:Key="Accent" Color="#2E5C9A"/>
        <SolidColorBrush x:Key="Border" Color="#DCDDE1"/>
        <SolidColorBrush x:Key="Muted" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="Ink" Color="#2C3E50"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>

        <!-- Section Label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Color Preset Chip Button Style (5px CornerRadius) -->
        <Style x:Key="ColorChipButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="5" BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Card Option Button (5px CornerRadius) -->
        <Style x:Key="StyleOptionButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bdr" Property="Background" Value="#EDF2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill Button (5px CornerRadius) -->
        <Style x:Key="FilterPillButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EDF2F7"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Style (5px CornerRadius) -->
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#234675"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" CornerRadius="5" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="border" Property="Background" Value="#EDF2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Content Area (No Header Banner as per rule) -->
            <RowDefinition Height="*"/>
            <!-- Footer Status -->
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN WORK AREA: TWO PANELS
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="14,12,14,8">
            <Grid.ColumnDefinitions>
                <!-- Left Panel: Controls (Width 320) -->
                <ColumnDefinition Width="320"/>
                <!-- Right Panel: Live Ribbon Preview -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT PANEL: CONTROLS ─── -->
            <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="5" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- SECTION 1: COLOR PRESETS -->
                        <TextBlock Text="Theme Color Presets" Style="{StaticResource SectionLabel}"/>
                        <ItemsControl ItemsSource="{Binding PresetColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ColorChipButton}"
                                            Background="{Binding Brush}"
                                            Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding HexCode}"
                                            ToolTip="{Binding Name}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- SECTION 2: CUSTOM HEX CODE -->
                        <TextBlock Text="Custom Hex Code" Style="{StaticResource SectionLabel}" Margin="0,12,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Height="26" Background="#F5F7F9" BorderBrush="{StaticResource Border}" BorderThickness="1,1,0,1" CornerRadius="5,0,0,5">
                                <TextBlock Text="#" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBox Grid.Column="1" Height="26" Text="{Binding SelectedColorHex, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Padding="6,0" FontSize="12"
                                     BorderBrush="{StaticResource Border}" BorderThickness="1,1,0,1"/>

                            <!-- Live Color Swatch Indicator -->
                            <Border Grid.Column="2" Height="26" Background="{Binding SelectedColorBrush}"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="0,5,5,0" ToolTip="Current Selected Color"/>
                        </Grid>

                        <!-- SECTION 3: ICON PRESENTATION STYLE -->
                        <TextBlock Text="Icon Presentation Style" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
                        <UniformGrid Columns="2" Rows="2">
                            <!-- Style 1: Badge -->
                            <Button Command="{Binding SelectStyleCommand}" CommandParameter="{x:Static models:RibbonIconStyle.Badge}"
                                    ToolTip="Badge: Rounded container with white glyph">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource StyleOptionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBadgeStyle}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Setter Property="Background" Value="#EDF2F7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="16" Height="16" CornerRadius="4" Background="{Binding SelectedColorBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Badge" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Style 2: Glyph -->
                            <Button Command="{Binding SelectStyleCommand}" CommandParameter="{x:Static models:RibbonIconStyle.Glyph}"
                                    ToolTip="Glyph: Transparent background with colored glyph">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource StyleOptionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGlyphStyle}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Setter Property="Background" Value="#EDF2F7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="F0 M4,3 H20 A2,2 0 0 1 22,5 V7.5 A2,2 0 0 1 20,9.5 H15 A1,1 0 0 0 14,10.5 V13.5 A1,1 0 0 0 15,14.5 H20 A2,2 0 0 1 22,16.5 V19 A2,2 0 0 1 20,21 H4 A2,2 0 0 1 2,19 V16.5 A2,2 0 0 1 4,14.5 H9 A1,1 0 0 0 10,13.5 V10.5 A1,1 0 0 0 9,9.5 H4 A2,2 0 0 1 2,7.5 V5 A2,2 0 0 1 4,3 Z" Width="14" Height="14" Stretch="Uniform" Fill="{Binding SelectedColorBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Glyph" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Style 3: Circle -->
                            <Button Command="{Binding SelectStyleCommand}" CommandParameter="{x:Static models:RibbonIconStyle.Circle}"
                                    ToolTip="Circle: Circular container with white glyph">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource StyleOptionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCircleStyle}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Setter Property="Background" Value="#EDF2F7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="16" Height="16" CornerRadius="8" Background="{Binding SelectedColorBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Circle" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Style 4: Outline -->
                            <Button Command="{Binding SelectStyleCommand}" CommandParameter="{x:Static models:RibbonIconStyle.Outline}"
                                    ToolTip="Outline: Tinted background with colored border">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource StyleOptionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutlineStyle}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Setter Property="Background" Value="#EDF2F7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="16" Height="16" CornerRadius="4" Background="#F5F7F9" BorderBrush="{Binding SelectedColorBrush}" BorderThickness="1.5" Margin="0,0,6,0"/>
                                    <TextBlock Text="Outline" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- SEPARATOR -->
                        <Border Height="1" Background="{StaticResource Border}" Margin="0,16,0,14"/>

                        <!-- SECTION 4: ACTIONS -->
                        <Button Style="{StaticResource PrimaryActionBtn}" Command="{Binding ApplyCommand}" Margin="0,0,0,8" ToolTip="Apply chosen theme to Revit Ribbon immediately">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="F0 M9.5,19.5 A2.5,2.5 0 0 1 7.7,18.7 L3.7,14.7 A2.5,2.5 0 0 1 7.2,11.2 L9.5,13.5 L17.8,4.2 A2.5,2.5 0 1 1 21.5,7.5 L11.3,18.7 A2.5,2.5 0 0 1 9.5,19.5 Z" Width="12" Height="12" Stretch="Uniform" Fill="White" Margin="0,0,6,0"/>
                                <TextBlock Text="Apply to Revit Ribbon" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryActionBtn}" Command="{Binding ResetCommand}" ToolTip="Reset ribbon icons to default style">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="F0 M12,2 A10,10 0 0 1 21.5,8.5 V5 A1.5,1.5 0 0 1 24.5,5 V11 A1.5,1.5 0 0 1 23,12.5 H17 A1.5,1.5 0 0 1 17,9.5 H20 A7,7 0 1 0 19,15 A1.5,1.5 0 0 1 21.9,15.8 A10,10 0 1 1 12,2 Z" Width="11" Height="11" Stretch="Uniform" Fill="{StaticResource Muted}" Margin="0,0,6,0"/>
                                <TextBlock Text="Reset to Default" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ─── RIGHT PANEL: LIVE RIBBON PREVIEW ─── -->
            <Border Grid.Column="1" Background="{StaticResource CardBg}" CornerRadius="5" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Filter Tabs -->
                        <RowDefinition Height="Auto"/>
                        <!-- Ribbon Simulated Bar -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Tabs -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Live Ribbon Preview" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Right">
                            <ItemsControl ItemsSource="{Binding Panels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource FilterPillButton}" Content="{Binding}"
                                                Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Simulated Ribbon Toolbar Grid -->
                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="5" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilteredButtons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Simulated Revit Ribbon PushButton Card (5px CornerRadius) -->
                                        <Border Width="80" Height="94" Margin="4" Background="#FFFFFF" CornerRadius="5"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="3"
                                                ToolTip="{Binding ToolTip}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="38"/>
                                                    <RowDefinition Height="38"/>
                                                    <RowDefinition Height="14"/>
                                                </Grid.RowDefinitions>

                                                <!-- 32x32 Live Image Preview (HighQuality Anti-aliasing) -->
                                                <Image Grid.Row="0" Source="{Binding ImagePreview}" Width="32" Height="32" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                                <!-- Button Text (2-lines, Normal weight) -->
                                                <TextBlock Grid.Row="1" Text="{Binding DisplayName}" FontSize="10.5" FontWeight="Normal"
                                                           Foreground="{StaticResource Ink}" TextAlignment="Center" TextWrapping="Wrap"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0"/>

                                                <!-- Panel Badge Pill -->
                                                <Border Grid.Row="2" Background="#F5F7F9" CornerRadius="3" Padding="3,1" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding PanelName}" FontSize="8.5" Foreground="{StaticResource Muted}" FontWeight="Normal"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             STATUS BAR (FOOTER)
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M12,2 A10,10 0 1 0 22,12 A10,10 0 0 0 12,2 Z M12,7 V13 M12,16 V17" Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="JNNTool • Ribbon Theme &amp; Vector Graphics" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
