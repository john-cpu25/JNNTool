<Window x:Class="JNNTool.RebarSuite.Stair.Views.StairRebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:JNNTool.RebarSuite.Stair.ViewModels"
        mc:Ignorable="d"
        Title="JNN Rebar — Bố trí Thép Bản Thang (TCVN 5574:2018)"
        Height="520" Width="660"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#F8FAFC"
        FontFamily="Segoe UI" FontSize="13">

    <Window.DataContext>
        <vm:StairRebarViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🪜" FontSize="20" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="JNN REBAR — BỐ TRÍ THÉP BẢN THANG" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC"/>
                    <TextBlock Text="Thép bản thang lớp dưới chịu uốn, thép mũ gối trên neo dầm và thép phân bố ngang" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tab Content -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#CBD5E1">

            <!-- TAB 1: THÉP DỌC BẢN THANG -->
            <TabItem Header="  Thép Chịu Lực (Lớp Dưới &amp; Mũ)  " FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <GroupBox Header="Thép Bản Thang Lớp Dưới (Chịu Nhịp)">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Đường kính thép dưới:" VerticalAlignment="Center" FontWeight="Normal"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding MainBarOptions}" SelectedItem="{Binding Settings.BottomDiameter}"/>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Khoảng cách a (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Settings.BottomSpacing, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Đoạn neo gối dầm (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.BottomAnchorLengthMm, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Lớp bảo vệ (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Settings.CoverMm, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Thép Lớp Trên / Mũ Gối (Gối Dầm &amp; Chiếu Nghỉ)">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="Bố trí thép mũ chịu mô-men âm tại gối" 
                                          IsChecked="{Binding Settings.CreateTopBars}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Hệ số vươn nhịp (L/4):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Settings.TopSpanFactor, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Settings.CreateTopBars}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Đường kính thép mũ:" VerticalAlignment="Center" FontWeight="Normal"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding MainBarOptions}" SelectedItem="{Binding Settings.TopDiameter}"
                                          IsEnabled="{Binding Settings.CreateTopBars}"/>

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Khoảng cách a (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Settings.TopSpacing, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Settings.CreateTopBars}"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: THÉP PHÂN BỐ -->
            <TabItem Header="  Thép Phân Bố Ngang  " FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <GroupBox Header="Cấu Hình Thép Phân Bố Ngang (Vuông Góc Thép Chính)">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Đường kính thép phân bố:" VerticalAlignment="Center" FontWeight="Normal"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DistBarOptions}" SelectedItem="{Binding Settings.DistributionDiameter}"/>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Khoảng cách a (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Settings.DistributionSpacing, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </GroupBox>

                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,0">
                            <TextBlock Text="💡 Thép phân bố ngang được rải đều đặn vuông góc với phương chịu lực chính dọc theo chiều dài vế dốc thang." 
                                       FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Footer / Status Bar & Action Buttons -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status Message -->
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#475569" FontStyle="Italic"/>

            <!-- Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Mặc Định" Width="100" Height="34" Margin="0,0,8,0"
                        Command="{Binding ResetDefaultsCommand}" Background="#E2E8F0" BorderBrush="#CBD5E1"/>
                <Button Content="Tạo Thép Thang" Width="130" Height="34"
                        Command="{Binding CreateRebarCommand}" FontWeight="Bold"
                        Background="#8B5CF6" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
