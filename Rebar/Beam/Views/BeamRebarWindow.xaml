<Window x:Class="JNNTool.RebarSuite.Beam.Views.BeamRebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:JNNTool.RebarSuite.Beam.ViewModels"
        mc:Ignorable="d"
        Title="JNN Rebar — Bố trí Thép Dầm Liên Tục (TCVN 5574:2018)"
        Height="580" Width="700"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#F8FAFC"
        FontFamily="Segoe UI" FontSize="13">

    <Window.DataContext>
        <vm:BeamRebarViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📏" FontSize="20" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="JNN REBAR — BỐ TRÍ THÉP DẦM LIÊN TỤC" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC"/>
                    <TextBlock Text="Tự động phân bổ thép chủ, thép gối L/4, đai dày/thưa và tạo mặt cắt theo TCVN 5574:2018" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tab Content -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#CBD5E1">

            <!-- TAB 1: THÉP CHỦ & GIA CƯỜNG -->
            <TabItem Header="  Thép Chủ &amp; Gia Cường  " FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- Thép Chủ -->
                        <GroupBox Header="Thép Chủ Chạy Suốt">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Đường kính chủ trên:" VerticalAlignment="Center" FontWeight="Normal"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding BarOptions}" SelectedItem="{Binding Settings.TopMainDiameter}"/>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Số thanh chủ trên:" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Settings.TopMainCount, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Đường kính chủ dưới:" VerticalAlignment="Center" FontWeight="Normal"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BarOptions}" SelectedItem="{Binding Settings.BottomMainDiameter}"/>

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Số thanh chủ dưới:" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Settings.BottomMainCount, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </GroupBox>

                        <!-- Thép Gia Cường Gối -->
                        <GroupBox Header="Thép Gia Cường Gối (Top Add — L/4)">
                            <StackPanel>
                                <CheckBox Content="Bố trí thép gia cường tại các gối tựa dầm" 
                                          IsChecked="{Binding Settings.EnableTopAdd}" 
                                          FontWeight="Normal" Margin="0,0,0,8"/>
                                <Grid IsEnabled="{Binding Settings.EnableTopAdd}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Đường kính tăng cường:" VerticalAlignment="Center" FontWeight="Normal"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding BarOptions}" SelectedItem="{Binding Settings.TopAddDiameter}"/>

                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Số thanh tăng cường:" VerticalAlignment="Center" FontWeight="Normal"/>
                                    <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Settings.TopAddCount, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Hệ số vươn nhịp (L/4):" VerticalAlignment="Center" FontWeight="Normal"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.TopAddSpanRatio, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Thép Gia Cường Nhịp -->
                        <GroupBox Header="Thép Gia Cường Nhịp (Bottom Add)">
                            <StackPanel>
                                <CheckBox Content="Bố trí thép gia cường vùng giữa nhịp" 
                                          IsChecked="{Binding Settings.EnableBottomAdd}" 
                                          FontWeight="Normal" Margin="0,0,0,8"/>
                                <Grid IsEnabled="{Binding Settings.EnableBottomAdd}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Đường kính tăng cường:" VerticalAlignment="Center" FontWeight="Normal"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding BarOptions}" SelectedItem="{Binding Settings.BottomAddDiameter}"/>

                                    <TextBlock Grid.Column="3" Text="Số thanh tăng cường:" VerticalAlignment="Center" FontWeight="Normal"/>
                                    <TextBox Grid.Column="4" Text="{Binding Settings.BottomAddCount, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: CỐT ĐAI & THÉP GIÁ -->
            <TabItem Header="  Cốt Đai &amp; Thép Giá  " FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- Cốt đai -->
                        <GroupBox Header="Cốt Đai Dầm (Vùng Dày Gối — Vùng Thưa Giữa Nhịp)">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Đường kính đai:" VerticalAlignment="Center" FontWeight="Normal"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding BarOptions}" SelectedItem="{Binding Settings.StirrupDiameter}"/>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Phạm vi đai dày (L/4):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Settings.StirrupDenseRangeRatio, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Khoảng rải gối (a dày mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.StirrupSpacingEnd, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Khoảng rải giữa (a thưa mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Settings.StirrupSpacingMid, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </GroupBox>

                        <!-- Thép Giá -->
                        <GroupBox Header="Thép Giá Cấu Tạo Thành Dầm">
                            <StackPanel>
                                <CheckBox Content="Tự động bố trí thép giá khi chiều cao dầm H ≥ 600 mm" 
                                          IsChecked="{Binding Settings.AutoSideRebar}" 
                                          FontWeight="Normal" Margin="0,0,0,8"/>
                                <Grid IsEnabled="{Binding Settings.AutoSideRebar}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Đường kính thép giá:" VerticalAlignment="Center" FontWeight="Normal"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding BarOptions}" SelectedItem="{Binding Settings.SideRebarDiameter}"/>

                                    <TextBlock Grid.Column="3" Text="Khoảng cách tối đa (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                    <TextBox Grid.Column="4" Text="{Binding Settings.MaxSideRebarSpacing, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: NEO, BẢO VỆ & MẶT CẮT -->
            <TabItem Header="  Neo &amp; Bản Vẽ Mặt Cắt  " FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <GroupBox Header="Lớp Bảo Vệ &amp; Đoạn Neo">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Lớp bảo vệ dầm (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="1" Text="{Binding Settings.CoverMm, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Column="3" Text="Hệ số neo cốt thép (35d):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="4" Text="{Binding Settings.AnchorLengthMultiplier, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Tự Động Tạo View Mặt Cắt">
                            <StackPanel Margin="0,4">
                                <CheckBox Content="Tự động tạo Mặt Cắt Dọc (MCD) cho chuỗi dầm" 
                                          IsChecked="{Binding Settings.CreateLongitudinalSection}" 
                                          FontWeight="Normal" Margin="0,0,0,8"/>
                                <Grid IsEnabled="{Binding Settings.CreateLongitudinalSection}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tiền tố tên View MCD:" VerticalAlignment="Center" FontWeight="Normal"/>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.ViewNamePrefix, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#475569" FontStyle="Italic"/>

                <Button Grid.Column="1" Content="Mặc Định" Command="{Binding ResetDefaultsCommand}"
                        Width="100" Height="34" Background="#E2E8F0" Foreground="#334155" BorderBrush="#CBD5E1" FontWeight="SemiBold"/>

                <Button Grid.Column="3" Content="✓ Tạo Thép Dầm" Command="{Binding CreateRebarCommand}"
                        Width="150" Height="34" Background="#0284C7" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
