<Window x:Class="JNNToolInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JNNTool Revit Plugin Installer"
        Width="630" Height="610"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="pack://application:,,,/Assets/logo.png"
        Background="Transparent">

    <Window.Resources>
        <!-- Primary Button style -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button style -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FEE2E2"/>
                    <Setter Property="Foreground" Value="#FCA5A5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card style (Light theme) -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Modern ProgressBar style -->
        <Style x:Key="ModernProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <Border x:Name="PART_Track" CornerRadius="4">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer border with soft shadow effect -->
    <Border CornerRadius="16" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" BlurRadius="25" ShadowDepth="4" Opacity="0.15"/>
        </Border.Effect>

        <Grid>
            <!-- Logo Watermark Background with soft white overlay -->
            <Grid ClipToBounds="True">
                <Image Source="pack://application:,,,/Assets/logo.png"
                       Stretch="Uniform"
                       Width="340" Height="340"
                       Opacity="0.05"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#EDFFFFFF" Offset="0"/>
                            <GradientStop Color="#DCF8FAFC" Offset="0.5"/>
                            <GradientStop Color="#F2FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- Main Layout without ScrollViewer (No scrollbar) -->
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>  <!-- Custom Title bar -->
                    <RowDefinition Height="*"/>   <!-- Main Content -->
                </Grid.RowDefinitions>

                <!-- Custom Title Bar -->
                <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid>
                        <!-- Left: App icon and macOS dots -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0">
                            <Image Source="pack://application:,,,/Assets/logo.png" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Ellipse Width="10" Height="10" Fill="#FF5F57" Margin="0,0,5,0" Cursor="Hand"
                                     PreviewMouseLeftButtonDown="CloseBtn_Click"/>
                            <Ellipse Width="10" Height="10" Fill="#FEBC2E" Margin="0,0,5,0" Cursor="Hand"
                                     PreviewMouseLeftButtonDown="MinimizeBtn_Click"/>
                            <Ellipse Width="10" Height="10" Fill="#28C840"/>
                        </StackPanel>

                        <!-- Center: title -->
                        <TextBlock Text="JNNTool Revit Plugin Installer"
                                   Foreground="#64748B" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Right: Win-style buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                            <Button x:Name="BtnMinimize" Click="MinimizeBtn_Click"
                                    Width="46" Height="32" Content="&#x2212;"
                                    FontSize="16" Foreground="#64748B" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                                            <Setter Property="Foreground" Value="#0F172A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="BtnClose" Click="CloseBtn_Click"
                                    Width="46" Height="32" Content="&#x2715;"
                                    FontSize="13" Foreground="#64748B" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0,15,0,0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#EF4444"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content Area (Clean, fits perfectly without scrollbar) -->
                <Grid Grid.Row="1" Margin="26,4,26,20">
                    <StackPanel VerticalAlignment="Top">

                        <!-- Header with JN Avatar Logo -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="52" Height="52" CornerRadius="12" Margin="0,0,14,0"
                                    ClipToBounds="True" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5">
                                <Image Source="pack://application:,,,/Assets/logo.png"
                                       Stretch="Uniform" Margin="4"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="JNNTool" FontSize="21" FontWeight="Bold"
                                           Foreground="#0F172A"/>
                                <TextBlock Text="Revit Plugin • Structural Engineering Tools"
                                           Foreground="#64748B" FontSize="12" FontWeight="Medium"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Version Status Cards -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!-- Installed version -->
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="INSTALLED" Foreground="#64748B"
                                               FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtInstalledVersion"
                                               Text="Chưa cài" Foreground="#0F172A"
                                               FontSize="19" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtInstallDate"
                                               Text="" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Latest version -->
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="LATEST" Foreground="#64748B"
                                               FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtLatestVersion"
                                               Text="—" Foreground="#2563EB"
                                               FontSize="19" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtLatestDate"
                                               Text="" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Update badge -->
                        <Border x:Name="UpdateBadge" Visibility="Collapsed"
                                Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1"
                                CornerRadius="10" Padding="14,8" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔔" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock x:Name="TxtUpdateTitle" Foreground="#15803D"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtUpdateSub" Foreground="#166534"
                                               FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Changelog Card -->
                        <Border x:Name="ChangelogPanel" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="CHANGELOG" Foreground="#64748B"
                                           FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="ChangelogList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1.5">
                                                <TextBlock Text="•" Foreground="#2563EB" Margin="0,0,8,0" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding}" Foreground="#334155"
                                                           FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Revit Versions Detected Card -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="REVIT VERSIONS DETECTED"
                                           Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                <WrapPanel x:Name="RevitVersionsPanel" Orientation="Horizontal"/>
                            </StackPanel>
                        </Border>

                        <!-- Progress Area -->
                        <Border x:Name="ProgressPanel" Style="{StaticResource Card}"
                                Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="TxtStatus" Foreground="#2563EB"
                                           FontSize="12" Margin="0,0,0,6" FontWeight="Medium"/>
                                <ProgressBar x:Name="ProgressBar" Style="{StaticResource ModernProgress}"
                                             Minimum="0" Maximum="100"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnInstall" Grid.Column="0"
                                    Style="{StaticResource PrimaryBtn}"
                                    Content="⬇  Cài đặt / Cập nhật"
                                    Click="BtnInstall_Click"/>

                            <Button x:Name="BtnUninstall" Grid.Column="2"
                                    Style="{StaticResource DangerBtn}"
                                    Content="Gỡ cài đặt"
                                    IsEnabled="False"
                                    Click="BtnUninstall_Click"/>
                        </Grid>

                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
