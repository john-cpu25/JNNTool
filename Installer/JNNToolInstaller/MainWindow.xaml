<Window x:Class="JNNToolInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JNN-STRUCTURAL"
        Width="900" Height="610"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="pack://application:,,,/Assets/Logo_JNN.ico"
        Background="Transparent"
        FontFamily="Segoe UI, Inter, sans-serif"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Dark ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#334155" CornerRadius="2.5"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Outline Button Style -->
        <Style x:Key="DarkOutlineBtn" TargetType="Button">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#40FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Dark Button Style -->
        <Style x:Key="SmallDarkBtn" TargetType="Button" BasedOn="{StaticResource DarkOutlineBtn}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red Outline Button Style (Gỡ cài đặt) -->
        <Style x:Key="RedOutlineBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="BorderBrush" Value="#40EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AEF4444"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#80EF4444"/>
                                <Setter Property="Foreground" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33EF4444"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Blue Gradient Button Style (Cài đặt / Cập nhật) -->
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1D4ED8" Offset="0"/>
                                    <GradientStop Color="#3B82F6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#3B82F6" BlurRadius="16" ShadowDepth="2" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2563EB" Offset="0"/>
                                            <GradientStop Color="#60A5FA" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1E40AF" Offset="0"/>
                                            <GradientStop Color="#2563EB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- Outer Card Container -->
    <Border CornerRadius="16" Background="#0D1117" BorderBrush="#1FFFFFFF" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Header Navbar (Dark Navy Gradient) -->
                <RowDefinition Height="*"/>    <!-- 1: Main Content Body -->
                <RowDefinition Height="Auto"/> <!-- 2: Progress Panel -->
                <RowDefinition Height="Auto"/> <!-- 3: Footer Action Bar -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════
                 ROW 0: HEADER NAVBAR
                 ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Padding="18,12" MouseDown="TitleBar_MouseDown" Cursor="SizeAll"
                    BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#161B25" Offset="0"/>
                        <GradientStop Color="#111620" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Logo & Brand -->
                        <ColumnDefinition Width="Auto"/> <!-- Online vs Máy status pill -->
                        <ColumnDefinition Width="Auto"/> <!-- Warning Alert -->
                        <ColumnDefinition Width="*"/>    <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Window Controls -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand Logo & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- JNN Brand Logo -->
                        <Border Width="36" Height="36" CornerRadius="10" Padding="3"
                                Background="#161B26" BorderBrush="#25FFFFFF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.45"/>
                            </Border.Effect>
                            <Image Source="pack://application:,,,/Assets/Logo_JNN.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="JNN-STRUCTURAL" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="STRUCTURAL DESIGN" FontSize="9.5" FontWeight="Normal" Foreground="#64748B" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center-Left: Online vs Máy Status Pill -->
                    <Border Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                            Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="16" Padding="12,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#10B981" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="TxtHeaderOnlineLabel" Text="Online " Foreground="#34D399" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtHeaderOnlineVer" Text="v2.1.3" Foreground="#6EE7B7" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="  →  " Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtHeaderMachineLabel" Text="Máy: " Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtHeaderInstalledVer" Text="Chưa cài" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Center-Right: Alert "Vui lòng TẮT REVIT trước khi cài" -->
                    <Border Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0"
                            Background="#1AF59E0B" BorderBrush="#40F59E0B" BorderThickness="1" CornerRadius="16" Padding="12,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Warning Triangle Path -->
                            <Path Width="12" Height="12" Stretch="Uniform" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Data="M12,2 L1,21 L23,21 Z M12,6 L13.5,15 L10.5,15 Z M12,17 A1.5,1.5 0 1 1 11.99,17 Z"/>
                            <TextBlock x:Name="TxtHeaderWarning" Text="Vui lòng TẮT REVIT trước khi cài" Foreground="#FCD34D" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: Window Buttons -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="MinimizeBtn_Click" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="6">
                                        <TextBlock Text="—" Foreground="#64748B" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Click="CloseBtn_Click" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="6">
                                        <TextBlock Text="✕" Foreground="#64748B" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#D9EF4444"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 ROW 1: MAIN BODY
                 ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="18,14,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Section: 2 Columns -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Section: Revit Versions Full Grid -->
                </Grid.RowDefinitions>

                <!-- TOP SECTION: 2 COLUMNS (Left Status Card & Right Changelog Tab) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CỘT TRÁI: Thẻ trạng thái & Hướng dẫn -->
                    <StackPanel Grid.Column="0">
                        <!-- Card 1: Trạng thái cài đặt (Amber tint) -->
                        <Border x:Name="StatusBadgeBorder" Background="#10F59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#F59E0B" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="TxtStatusHeadline" Text="Sẵn sàng cài đặt" Foreground="#FCD34D" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtOnlineVerLabel" Text="Phiên bản Online" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtOnlineVerVal" Text="v2.1.3" Foreground="#60A5FA" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="#0FFFFFFF" Margin="0,2,0,8"/>

                                <Grid>
                                    <TextBlock x:Name="TxtInstalledVerLabel" Text="Hiện tại" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtInstalledVerVal" Text="Chưa cài" Foreground="#94A3B8" FontWeight="Medium" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Hướng dẫn (Blue tint) -->
                        <Border Background="#0D1D4ED8" BorderBrush="#203B82F6" BorderThickness="1" CornerRadius="12" Padding="12,12" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Info Circle Path -->
                                <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform" Fill="#38BDF8" Margin="0,2,8,0" VerticalAlignment="Top"
                                      Data="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M11,7 L13,7 L13,9 L11,9 Z M11,11 L13,11 L13,17 L11,17 Z"/>
                                <TextBlock x:Name="TxtHint" Grid.Column="1" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" LineHeight="16">
                                    Chọn phiên bản Revit bên dưới rồi bấm "Cài đặt" để cập nhật.
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- CỘT PHẢI: Tabbed Changelog & Info -->
                    <Border Grid.Column="1" Background="#0F141E" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Margin="14,0,0,0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/> <!-- Tab bar -->
                                <RowDefinition Height="*"/>  <!-- Tab content -->
                            </Grid.RowDefinitions>

                            <!-- Tab Bar -->
                            <Border Grid.Row="0" Background="#161B25" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Tab 1: Nhật ký phiên bản -->
                                    <Button x:Name="TabChangelogBtn" Click="TabChangelog_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="10,0" Margin="0,0,4,0" FocusVisualStyle="{x:Null}">
                                        <Border x:Name="TabChangelogBorder" BorderBrush="#3B82F6" BorderThickness="0,0,0,2" Padding="4,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📖 " FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TabChangelogTxt" Text="Nhật ký phiên bản" Foreground="#60A5FA" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <!-- Tab 2: Thông tin -->
                                    <Button x:Name="TabInfoBtn" Click="TabInfo_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="10,0" FocusVisualStyle="{x:Null}">
                                        <Border x:Name="TabInfoBorder" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="4,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="ⓘ " FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TabInfoTxt" Text="Thông tin" Foreground="#64748B" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Tab Content -->
                            <Grid Grid.Row="1" Margin="14,12,14,12">
                                <!-- VIEW 1: CHANGELOG -->
                                <Grid x:Name="ChangelogView" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtChangelogVersion" Text="Version 2.1.3" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            <Border Background="#203B82F6" CornerRadius="10" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Latest" Foreground="#60A5FA" FontSize="9.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtChangelogSubtitle" Text="Nhật ký phiên bản JNNTool" FontSize="11" Foreground="#475569" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Scrollable Changelog List -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Height="105" Focusable="False">
                                        <ItemsControl x:Name="ChangelogList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="14"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="4" Height="4" Fill="#3B82F6" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#94A3B8" FontSize="11.5" TextWrapping="Wrap" LineHeight="17"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>

                                <!-- VIEW 2: INFO -->
                                <StackPanel x:Name="InfoView" Visibility="Collapsed" VerticalAlignment="Center" Margin="6,0">
                                    <TextBlock x:Name="TxtInfoHeader" Text="JNN-STRUCTURAL REVIT ADD-IN" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtInfoSubHeader" Text="Phiên bản phát hành: v2.1.3 (Auto-Deploy Per-User MSI)" FontSize="11" Foreground="#38BDF8" Margin="0,4,0,8"/>
                                    <TextBlock x:Name="TxtInfoPlatform" Text="• Nền tảng hỗ trợ: Autodesk Revit 2022, 2023, 2024, 2025, 2026, 2027" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <TextBlock x:Name="TxtInfoDeveloper" Text="• Tác giả: JNN Engineering Team" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <TextBlock x:Name="TxtInfoRepo" Text="• Kho phân phối: github.com/john-cpu25/JNNTool" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <TextBlock x:Name="TxtInfoScope" Text="• Chuẩn cài đặt: %APPDATA% (Không cần quyền Administrator)" FontSize="11" Foreground="#10B981" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- BOTTOM SECTION: PHIÊN BẢN REVIT SELECTOR -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header + Buttons -->
                        <RowDefinition Height="Auto"/> <!-- 6 Cards Row -->
                    </Grid.RowDefinitions>

                    <!-- Header: Label + Select All / Deselect -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtRevitSectionTitle" Text="Phiên bản Revit" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="TxtRevitSectionSubtitle" Text=" (Dòng 1: Chọn cài | Dòng 2: Trong máy)" Foreground="#475569" FontSize="11" VerticalAlignment="Center" Margin="4,1,0,0"/>
                        </StackPanel>

                        <!-- Quick Select Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnSelectAll" Content="Chọn tất cả" Style="{StaticResource SmallDarkBtn}" Click="BtnSelectAllRevit_Click" Margin="0,0,6,0"/>
                            <Button x:Name="BtnDeselectAll" Content="Bỏ chọn" Style="{StaticResource SmallDarkBtn}" Click="BtnDeselectAllRevit_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 6 Revit Version Cards -->
                    <ItemsControl x:Name="RevitVersionCards" Grid.Row="1">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="RevitCard_Click" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,8,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{Binding CardBackground}"
                                                    BorderBrush="{Binding CardBorder}"
                                                    BorderThickness="1" CornerRadius="10" Padding="8,10">
                                                <Grid>
                                                    <!-- Green Dot top-right indicator (Installed in machine) -->
                                                    <Ellipse Width="6" Height="6" Fill="#10B981" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                             Visibility="{Binding GreenDotVisibility}">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#10B981" BlurRadius="4" ShadowDepth="0" Opacity="0.8"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>

                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <!-- Checkbox Indicator -->
                                                        <Border Width="16" Height="16" CornerRadius="4"
                                                                Background="{Binding CheckboxBackground}"
                                                                BorderBrush="{Binding CheckboxBorder}"
                                                                BorderThickness="1.5" HorizontalAlignment="Center">
                                                            <Path Width="9" Height="9" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z"
                                                                  Visibility="{Binding CheckmarkVisibility}"/>
                                                        </Border>

                                                        <!-- Year Label -->
                                                        <TextBlock Text="{Binding Year}"
                                                                   Foreground="{Binding YearColor}"
                                                                   FontWeight="Bold" FontSize="14"
                                                                   HorizontalAlignment="Center" Margin="0,6,0,2"/>

                                                        <!-- Status Text -->
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Foreground="{Binding StatusColor}"
                                                                   FontSize="9.5" FontWeight="Medium"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 ROW 2: PROGRESS BAR & STATUS
                 ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" x:Name="ProgressPanel" Visibility="Collapsed" Margin="18,10,18,0">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="TxtStatus" Text="Đang cài đặt..." Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtProgressPercent" Text="0%" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar x:Name="ProgressBar" Height="6" Background="#0FFFFFFF" Foreground="#10B981" BorderThickness="0">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                                    <Grid x:Name="PART_Track">
                                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#10B981" Offset="0"/>
                                                    <GradientStop Color="#34D399" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 ROW 3: FOOTER ACTION BAR
                 ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="3" Background="#0D1117" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="18,12" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Left: Uninstall & Lang -->
                        <ColumnDefinition Width="*"/>    <!-- Center Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Right Actions: Version Dropdown, Check, Install -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Gỡ cài đặt, Ngôn ngữ -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnUninstall" Content="🗑 Gỡ cài đặt" Style="{StaticResource RedOutlineBtn}" Click="BtnUninstall_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnLang" Content="🌐 VI" Style="{StaticResource DarkOutlineBtn}" Width="56" Padding="0" Click="BtnLang_Click"/>
                    </StackPanel>

                    <!-- Right Buttons: Dropdown, Kiểm tra File, Cài đặt / Cập nhật -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Version Dropdown -->
                        <ComboBox x:Name="CmbReleaseSelect" Width="140" SelectedIndex="0" Margin="0,0,8,0" Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="CmbReleaseSelect_SelectionChanged"/>

                        <!-- Kiểm tra File button -->
                        <Button x:Name="BtnCheckUpdate" Content="🔍 Kiểm tra File" Style="{StaticResource DarkOutlineBtn}" Click="BtnCheckUpdate_Click" Margin="0,0,10,0"/>

                        <!-- Primary Install / Update Button -->
                        <Button x:Name="BtnInstall" Style="{StaticResource PrimaryActionBtn}" Click="BtnInstall_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⬇ " FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtInstallAction" Text="Cài đặt / Cập nhật" VerticalAlignment="Center"/>
                                <Border x:Name="BadgeCountBorder" Background="#33FFFFFF" CornerRadius="10" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSelectedCount" Text="4" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
