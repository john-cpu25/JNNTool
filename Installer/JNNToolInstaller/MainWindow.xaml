<Window x:Class="JNNToolInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JNNTool Revit Plugin Installer"
        Width="620" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Button style -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#4F8EF7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#6BA3FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A76E8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#3A3F5C"/>
                                <Setter Property="Foreground" Value="#555D8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#E05555"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F06868"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1E2340"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,14"/>
        </Style>

        <!-- ProgressBar style -->
        <Style x:Key="ModernProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#2A3060"/>
            <Setter Property="Foreground" Value="#4F8EF7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <Border x:Name="PART_Track" CornerRadius="4">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer border with shadow effect -->
    <Border CornerRadius="18" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <!-- Background gradient -->
            <Border CornerRadius="18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D1128" Offset="0"/>
                        <GradientStop Color="#131832" Offset="0.5"/>
                        <GradientStop Color="#0F1530" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Accent glow top-left -->
            <Ellipse Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-80,-80,0,0" Opacity="0.08">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4F8EF7" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>  <!-- Title bar -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid>
                        <!-- Left: macOS dots -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0">
                            <Ellipse Width="12" Height="12" Fill="#FF5F57" Margin="0,0,6,0" Cursor="Hand"
                                     PreviewMouseLeftButtonDown="CloseBtn_Click"/>
                            <Ellipse Width="12" Height="12" Fill="#FEBC2E" Margin="0,0,6,0" Cursor="Hand"
                                     PreviewMouseLeftButtonDown="MinimizeBtn_Click"/>
                            <Ellipse Width="12" Height="12" Fill="#28C840"/>
                        </StackPanel>

                        <!-- Center: title -->
                        <TextBlock Text="JNNTool Revit Plugin Installer"
                                   Foreground="#8A93C8" FontSize="13" FontWeight="Medium"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Right: Win-style buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                            <Button x:Name="BtnMinimize" Click="MinimizeBtn_Click"
                                    Width="46" Height="32" Content="&#x2212;"
                                    FontSize="16" Foreground="#8A93C8" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#2A3060"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="BtnClose" Click="CloseBtn_Click"
                                    Width="46" Height="32" Content="&#x2715;"
                                    FontSize="13" Foreground="#8A93C8" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0,18,0,0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="28,0,28,28">
                    <StackPanel>

                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                            <!-- Icon placeholder -->
                            <Border Width="52" Height="52" CornerRadius="14" Margin="0,0,16,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4F8EF7" Offset="0"/>
                                        <GradientStop Color="#7B61FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="N" FontSize="26" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="JNNTool" FontSize="22" FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="Revit Plugin • Structural Engineering Tools"
                                           Foreground="#6B77B0" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Version Status Cards -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!-- Installed version -->
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="INSTALLED" Foreground="#4A5280"
                                               FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtInstalledVersion"
                                               Text="Chưa cài" Foreground="#E0E6FF"
                                               FontSize="20" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtInstallDate"
                                               Text="" Foreground="#4A5280" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Latest version -->
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="LATEST" Foreground="#4A5280"
                                               FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtLatestVersion"
                                               Text="—" Foreground="#4F8EF7"
                                               FontSize="20" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtLatestDate"
                                               Text="" Foreground="#4A5280" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Update badge -->
                        <Border x:Name="UpdateBadge" Visibility="Collapsed"
                                Background="#1B2B1F" CornerRadius="10"
                                Padding="14,10" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔔" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock x:Name="TxtUpdateTitle" Foreground="#4ADE80"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtUpdateSub" Foreground="#3A5C45"
                                               FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Changelog -->
                        <Border x:Name="ChangelogPanel" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="CHANGELOG" Foreground="#4A5280"
                                           FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="ChangelogList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="•" Foreground="#4F8EF7" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding}" Foreground="#C0C8F0"
                                                           FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Revit Versions detected -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="REVIT VERSIONS DETECTED"
                                           Foreground="#4A5280" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                                <WrapPanel x:Name="RevitVersionsPanel" Orientation="Horizontal"/>
                            </StackPanel>
                        </Border>

                        <!-- Progress area -->
                        <Border x:Name="ProgressPanel" Style="{StaticResource Card}"
                                Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="TxtStatus" Foreground="#8A93C8"
                                           FontSize="12" Margin="0,0,0,8"/>
                                <ProgressBar x:Name="ProgressBar" Style="{StaticResource ModernProgress}"
                                             Minimum="0" Maximum="100"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnInstall" Grid.Column="0"
                                    Style="{StaticResource PrimaryBtn}"
                                    Content="⬇  Cài đặt / Cập nhật"
                                    Click="BtnInstall_Click"/>

                            <Button x:Name="BtnUninstall" Grid.Column="2"
                                    Style="{StaticResource DangerBtn}"
                                    Content="Gỡ cài đặt"
                                    IsEnabled="False"
                                    Click="BtnUninstall_Click"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
