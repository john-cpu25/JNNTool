    <MediaTemplate EmbedCab="yes" />

    <!-- Giao dien wizard gon (Welcome -> Install -> Finish) -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUIDialogBmp"  Value="Assets\Dialog.bmp" />

    <Icon Id="AppIcon.ico" SourceFile="JNNToolInstaller\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />



    <!-- ============================================================
         Cau truc thu muc cai dat
         C:\ProgramData\Autodesk\ApplicationPlugins\JNNTool.bundle\
         ============================================================ -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="AutodeskDir"   Name="Autodesk">
        <Directory Id="PluginsDir"  Name="ApplicationPlugins">
          <Directory Id="INSTALLFOLDER" Name="JNNTool.bundle">
            <Directory Id="ContentsDir" Name="Contents">
              <Directory Id="Dir2022" Name="2022" />
              <Directory Id="Dir2023" Name="2023" />
              <Directory Id="Dir2024" Name="2024" />
              <Directory Id="Dir2025" Name="2025" />
              <Directory Id="Dir2026" Name="2026" />
              <Directory Id="Dir2027" Name="2027" />
              <Directory Id="ResourcesDir" Name="Resources" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Shortcut trong Start Menu -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="JNNTool" />
    </StandardDirectory>

    <!-- Thu muc cai dat JNNToolInstaller.exe -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="JNNDir" Name="JNN">
        <Directory Id="AppDir" Name="JNNTool" />
      </Directory>
    </StandardDirectory>

    <!-- ============================================================
         Cac component
         ============================================================ -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <!-- JNNToolInstaller.exe cai vao Program Files -->
      <Component Id="CmpUpdaterExe" Guid="*" Directory="AppDir">
        <File Id="UpdaterExe"
              Source="publish\JNNToolInstaller.exe"
              KeyPath="yes" />
      </Component>
      <Component Id="CmpUpdaterDll" Guid="*" Directory="AppDir">
        <File Id="UpdaterDll"
              Source="publish\JNNToolInstaller.dll"
              KeyPath="yes" />
      </Component>
      <Component Id="CmpUpdaterRuntimeConfig" Guid="*" Directory="AppDir">
        <File Id="UpdaterRuntimeConfig"
              Source="publish\JNNToolInstaller.runtimeconfig.json"
              KeyPath="yes" />
      </Component>
      <Component Id="CmpUpdaterDeps" Guid="*" Directory="AppDir">
        <File Id="UpdaterDeps"
              Source="publish\JNNToolInstaller.deps.json"
              KeyPath="yes" />
      </Component>

      <!-- icon.ico cai vao Program Files (dung cho shortcut) -->
      <Component Id="CmpUpdaterIcon" Guid="*" Directory="AppDir">
        <File Id="UpdaterIconFile"
              Source="JNNToolInstaller\icon.ico"
              KeyPath="yes" />
      </Component>

      <Component Id="CmpUpdaterVersion" Guid="*" Directory="AppDir">
        <File Id="UpdaterVersionJson"
              Source="JNNToolInstaller\version.json"
              KeyPath="yes" />
      </Component>

      <!-- Start Menu shortcuts -->
      <Component Id="StartMenuShortcut" Guid="85873994-3754-4a57-8894-394875489754"
                 Directory="AppMenuFolder">
        <!-- Shortcut mo JNNTool Updater -->
        <Shortcut Id="UpdaterShortcut"
                  Name="JNNTool Updater"
                  Target="[AppDir]JNNToolInstaller.exe"
                  WorkingDirectory="AppDir"
                  Icon="AppIcon.ico"
                  Description="Quan ly va cap nhat JNNTool Revit Plugin" />
        <!-- Shortcut go cai dat -->
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall JNNTool"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]"
                  Description="Go cai dat JNNTool Revit Plugin" />
        <RemoveFolder Id="AppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\JNN\JNNTool"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Bundle root: PackageContents.xml + version.json -->
      <Component Id="CmpPackageContents" Guid="*">
        <File Id="PackageContentsXml"
              Source="..\JNNTool.bundle\PackageContents.xml" KeyPath="yes" />
      </Component>

      <Component Id="CmpVersionJson" Guid="*">
        <File Id="VersionJson"
              Source="..\JNNTool.bundle\version.json" KeyPath="yes" />
      </Component>

      <!-- Revit 2022 / 2023 / 2024 (net48) -->
      <Component Id="Cmp2022" Guid="*" Directory="Dir2022">
        <File Id="Dll2022"   Source="..\JNNTool.bundle\Contents\2022\JNNTool.dll"   KeyPath="yes" />
        <File Id="Addin2022" Source="..\JNNTool.bundle\Contents\2022\JNNTool.addin" />
      </Component>

      <Component Id="Cmp2023" Guid="*" Directory="Dir2023">
        <File Id="Dll2023"   Source="..\JNNTool.bundle\Contents\2023\JNNTool.dll"   KeyPath="yes" />
        <File Id="Addin2023" Source="..\JNNTool.bundle\Contents\2023\JNNTool.addin" />
      </Component>

      <Component Id="Cmp2024" Guid="*" Directory="Dir2024">
        <File Id="Dll2024"   Source="..\JNNTool.bundle\Contents\2024\JNNTool.dll"   KeyPath="yes" />
        <File Id="Addin2024" Source="..\JNNTool.bundle\Contents\2024\JNNTool.addin" />
      </Component>

      <!-- Revit 2025 / 2026 (net8) -->
      <Component Id="Cmp2025" Guid="*" Directory="Dir2025">
        <File Id="Dll2025"   Source="..\JNNTool.bundle\Contents\2025\JNNTool.dll"   KeyPath="yes" />
        <File Id="Addin2025" Source="..\JNNTool.bundle\Contents\2025\JNNTool.addin" />
      </Component>

      <Component Id="Cmp2026" Guid="*" Directory="Dir2026">
        <File Id="Dll2026"   Source="..\JNNTool.bundle\Contents\2026\JNNTool.dll"   KeyPath="yes" />
        <File Id="Addin2026" Source="..\JNNTool.bundle\Contents\2026\JNNTool.addin" />
      </Component>

      <!-- Revit 2027 (net10) -->
