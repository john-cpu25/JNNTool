<?xml version="1.0" encoding="UTF-8"?>
<!--
  JNNTool Revit Plugin - WiX v4 MSI Installer (Per-User AppData)
  Cai dat vao: %APPDATA%\Autodesk\ApplicationPlugins\JNNTool.bundle\
  Ho tro: Revit 2022 - 2027 (Khong can quyen Administrator)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="JNNTool Revit Plugin"
           Manufacturer="JNN"
           Version="2.1.3"
           UpgradeCode="7f04a601-5e26-4b8c-8f4b-57f920f92b7c"
           Compressed="yes"
           Scope="perUser">

    <MajorUpgrade
      DowngradeErrorMessage="Phien ban moi hon da duoc cai. Vui long go cai dat truoc."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUIDialogBmp" Value="Assets\Dialog.bmp" />

    <Icon Id="AppIcon.ico" SourceFile="JNNToolInstaller\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <!-- Thu muc cai dat Per-User (%APPDATA%) -->
    <StandardDirectory Id="AppDataFolder">
      <Directory Id="AutodeskDir" Name="Autodesk">
        <Directory Id="PluginsDir" Name="ApplicationPlugins">
          <Directory Id="INSTALLFOLDER" Name="JNNTool.bundle">
            <Directory Id="ContentsDir" Name="Contents">
              <Directory Id="Dir2022" Name="2022" />
              <Directory Id="Dir2023" Name="2023" />
              <Directory Id="Dir2024" Name="2024" />
              <Directory Id="Dir2025" Name="2025" />
              <Directory Id="Dir2026" Name="2026" />
              <Directory Id="Dir2027" Name="2027" />
              <Directory Id="ResourcesDir" Name="Resources" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Start Menu (Per-User) -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="JNNTool" />
    </StandardDirectory>

    <!-- LocalAppData Programs (Per-User standard) -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="JNNDir" Name="JNN">
          <Directory Id="AppDir" Name="JNNTool" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <!-- JNNToolUpdater.exe trong LocalAppData\Programs\JNN\JNNTool -->
      <Component Id="CmpUpdaterExe" Guid="*" Directory="AppDir">
        <File Id="UpdaterExe" Source="publish\JNNToolUpdater.exe" KeyPath="yes" />
      </Component>
      <Component Id="CmpUpdaterDll" Guid="*" Directory="AppDir">
        <File Id="UpdaterDll" Source="publish\JNNToolUpdater.dll" KeyPath="yes" />
      </Component>
      <Component Id="CmpUpdaterRuntimeConfig" Guid="*" Directory="AppDir">
        <File Id="UpdaterRuntimeConfig" Source="publish\JNNToolUpdater.runtimeconfig.json" KeyPath="yes" />
      </Component>
      <Component Id="CmpUpdaterDeps" Guid="*" Directory="AppDir">
        <File Id="UpdaterDeps" Source="publish\JNNToolUpdater.deps.json" KeyPath="yes" />
      </Component>

      <!-- icon.ico trong AppDir -->
      <Component Id="CmpUpdaterIcon" Guid="*" Directory="AppDir">
        <File Id="UpdaterIconFile" Source="JNNToolInstaller\icon.ico" KeyPath="yes" />
      </Component>

      <Component Id="CmpUpdaterVersion" Guid="*" Directory="AppDir">
        <File Id="UpdaterVersionJson" Source="JNNToolInstaller\version.json" KeyPath="yes" />
      </Component>

      <!-- Shortcuts & Registry -->
      <Component Id="StartMenuShortcut" Guid="85873994-3754-4a57-8894-394875489754" Directory="AppMenuFolder">
        <Shortcut Id="UpdaterShortcut"
                  Name="JNNTool Updater"
                  Target="[AppDir]JNNToolUpdater.exe"
                  WorkingDirectory="AppDir"
                  Icon="AppIcon.ico"
                  Description="Quan ly va cap nhat JNNTool Revit Plugin" />
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall JNNTool"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]"
                  Description="Go cai dat JNNTool Revit Plugin" />
        <RemoveFolder Id="AppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\JNN\JNNTool" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\JNN\JNNTool" Name="ProductCode" Type="string" Value="[ProductCode]" />
      </Component>

      <!-- Bundle root: PackageContents.xml + version.json -->
      <Component Id="CmpPackageContents" Guid="*">
        <File Id="PackageContentsXml" Source="..\JNNTool.bundle\PackageContents.xml" KeyPath="yes" />
      </Component>
      <Component Id="CmpVersionJson" Guid="*">
        <File Id="VersionJson" Source="..\JNNTool.bundle\version.json" KeyPath="yes" />
      </Component>

      <!-- Revit 2022 -->
