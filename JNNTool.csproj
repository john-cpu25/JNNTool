<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <EnableDefaultPageItems>true</EnableDefaultPageItems>
    <GenerateAssemblySupportedOSPlatformAttribute>false</GenerateAssemblySupportedOSPlatformAttribute>
    <GenerateAssemblyTargetPlatformAttribute>false</GenerateAssemblyTargetPlatformAttribute>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>JNNTool</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <IncludePackageReferencesDuringMarkupCompilation>true</IncludePackageReferencesDuringMarkupCompilation>
  </PropertyGroup>

  <!-- Fix WPF temp project not running source generators for CommunityToolkit.Mvvm -->
  <PropertyGroup>
    <_MvvmAnalyzer>$(NuGetPackageRoot)communitytoolkit.mvvm\8.4.2\analyzers\dotnet\roslyn4.3\cs\CommunityToolkit.Mvvm.SourceGenerators.dll</_MvvmAnalyzer>
  </PropertyGroup>
  <Target Name="FixWpfTmpProjectSourceGenerators" AfterTargets="_GenerateCompileDependencyCache" BeforeTargets="MarkupCompilePass1">
    <ItemGroup>
      <ReferencePath Include="$(_MvvmAnalyzer)" Condition="Exists('$(_MvvmAnalyzer)')">
        <ReferenceSourceTarget>ProjectReference</ReferenceSourceTarget>
      </ReferencePath>
    </ItemGroup>
  </Target>
  
  <ItemGroup>
    <Compile Remove="Tools\**\obj\**" />
    <Compile Remove="Tools\**\bin\**" />
    <Compile Remove="Installer\**" />
    <Page Remove="Tools\**\obj\**" />
    <Page Remove="Tools\**\bin\**" />
    <Page Remove="Installer\**" />
  </ItemGroup>

  <!-- Revit API references using Nice3point.Revit.Api -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2022.1.1" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2022.1.1" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.0.0" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.0.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
  </ItemGroup>

  <!-- Post-build step to assemble the autoloader bundle -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <PropertyGroup>
      <BundleFolder>$(ProjectDir)JNNTool.bundle</BundleFolder>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
      <VersionFolder Include="2022;2023;2024" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
      <VersionFolder Include="2025;2026" />
    </ItemGroup>

    <MakeDir Directories="$(BundleFolder)\Contents\%(VersionFolder.Identity)" />
    
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(BundleFolder)\Contents\%(VersionFolder.Identity)" />
    <Copy SourceFiles="$(ProjectDir)JNNTool.addin" DestinationFolder="$(BundleFolder)\Contents\%(VersionFolder.Identity)" />
    
    <!-- Tự động đóng gói toàn bộ biểu tượng nằm trong thư mục Tools -->
    <MakeDir Directories="$(BundleFolder)\Contents\Resources" />
    <ItemGroup>
      <ToolIcons Include="$(ProjectDir)Tools\**\*.png" />
    </ItemGroup>
    <Copy SourceFiles="@(ToolIcons)" DestinationFolder="$(BundleFolder)\Contents\Resources\" SkipUnchangedFiles="true" />
    
    <Copy SourceFiles="$(ProjectDir)PackageContents.xml" DestinationFolder="$(BundleFolder)" SkipUnchangedFiles="true" />
    <!-- Copy version.json vào bundle root để auto-update check -->
    <Copy SourceFiles="$(ProjectDir)JNNTool.bundle\version.json"
          DestinationFolder="$(BundleFolder)"
          Condition="Exists('$(ProjectDir)JNNTool.bundle\version.json')"
          SkipUnchangedFiles="true" />

    <!-- Tự động đồng bộ toàn bộ Bundle tới C:\ProgramData\Autodesk\ApplicationPlugins để Revit tự nhận diện -->
    <PropertyGroup>
      <ProgramDataBundle>C:\ProgramData\Autodesk\ApplicationPlugins\JNNTool.bundle</ProgramDataBundle>
    </PropertyGroup>
    <MakeDir Directories="$(ProgramDataBundle)" />
    <ItemGroup>
      <BundleFiles Include="$(BundleFolder)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(BundleFiles)" DestinationFiles="@(BundleFiles->'$(ProgramDataBundle)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" ContinueOnError="true" />
  </Target>
</Project>
